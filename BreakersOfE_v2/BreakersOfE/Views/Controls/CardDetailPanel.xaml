<UserControl x:Class="BreakersOfE.Views.Controls.CardDetailPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Shared left-side card detail panel: grid page, gallery page, and
         (later) collection pages all host this one control. -->
    <UserControl.Resources>
        <Style x:Key="DetailLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
            <Setter Property="Margin" Value="0,6,0,1"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
        </Style>
        <Style x:Key="DetailValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="DetailPanel">

            <!-- Card image -->
            <Border CornerRadius="8" Background="#20808080"
                    HorizontalAlignment="Center" Margin="0,0,0,8"
                    MaxWidth="220">
                <Image x:Name="DetailCardImage" Stretch="Uniform"
                       MaxHeight="310"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       MouseLeftButtonDown="DetailImage_MouseDoubleClick"
                       Cursor="Hand"/>
            </Border>

            <!-- Show Back Face button (hidden by default) -->
            <Button x:Name="BtnShowBackFace" Content="🔄 Show Back Face"
                    HorizontalAlignment="Center" Margin="0,0,0,8"
                    Padding="8,4" FontSize="11"
                    Visibility="Collapsed"
                    Click="BtnShowBackFace_Click"/>

            <!-- Detail fields -->
            <TextBlock Text="NAME" Style="{StaticResource DetailLabel}"/>
            <TextBlock x:Name="DetailName" Style="{StaticResource DetailValue}"
                       FontSize="15" FontWeight="Bold"/>

            <TextBlock Text="MANA COST" Style="{StaticResource DetailLabel}"/>
            <ItemsControl x:Name="DetailManaCost" Margin="0,0,0,6">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <TextBlock Text="TYPE" Style="{StaticResource DetailLabel}"/>
            <TextBlock x:Name="DetailType" Style="{StaticResource DetailValue}"/>

            <TextBlock Text="SET" Style="{StaticResource DetailLabel}"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <Image x:Name="DetailSetSymbol" Width="16" Height="16"
                       Margin="0,0,5,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="DetailSet" Style="{StaticResource DetailValue}"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <TextBlock Text="COLLECTOR NUMBER" Style="{StaticResource DetailLabel}"/>
            <TextBlock x:Name="DetailCollectorNumber" Style="{StaticResource DetailValue}"/>

            <TextBlock Text="RARITY" Style="{StaticResource DetailLabel}"/>
            <TextBlock x:Name="DetailRarity" Style="{StaticResource DetailValue}"/>

            <TextBlock x:Name="DetailPTLabel" Text="POWER / TOUGHNESS"
                       Style="{StaticResource DetailLabel}"/>
            <TextBlock x:Name="DetailPT" Style="{StaticResource DetailValue}"/>

            <TextBlock Text="ORACLE TEXT" Style="{StaticResource DetailLabel}"/>
            <TextBlock x:Name="DetailOracle" Style="{StaticResource DetailValue}"
                       FontSize="12" TextWrapping="Wrap"/>

            <TextBlock Text="FLAVOR TEXT" Style="{StaticResource DetailLabel}"/>
            <TextBlock x:Name="DetailFlavor" Style="{StaticResource DetailValue}"
                       FontSize="12" FontStyle="Italic" Opacity="0.7"
                       TextWrapping="Wrap"/>

            <TextBlock Text="ARTIST" Style="{StaticResource DetailLabel}"/>
            <TextBlock x:Name="DetailArtist" Style="{StaticResource DetailValue}"/>

            <TextBlock Text="AVAILABLE AS" Style="{StaticResource DetailLabel}"/>
            <TextBlock x:Name="DetailFinishes" Style="{StaticResource DetailValue}"/>

            <TextBlock Text="PRICES (USD)" Style="{StaticResource DetailLabel}"/>
            <TextBlock x:Name="DetailPrices" Style="{StaticResource DetailValue}"
                       FontSize="12"/>

        </StackPanel>
    </ScrollViewer>
</UserControl>
