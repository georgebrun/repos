<UserControl x:Class="BreakersOfE.Views.Controls.GalleryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Card gallery view: virtualized rows of N image tiles, on-demand image
         download (cached by ScryfallId), own size slider. Self-contained so any
         page can host it: the View tables and the Edit pages. The host
         feeds it cards in display order and reacts to CardClicked/CardOpened. -->
    <UserControl.Resources>
        <!-- Small − / + inside a finish's count box (Edit pages) -->
        <Style x:Key="SlotButton" TargetType="Button">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="4" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="0,-2,0,0"
                                              TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                              TextElement.FontSize="15"
                                              TextElement.FontWeight="Bold"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#40808080"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#80808080"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

    <ListBox Grid.Row="0" x:Name="GalleryList"
             Background="Transparent" BorderThickness="0"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
             ScrollViewer.CanContentScroll="True"
             VirtualizingPanel.IsVirtualizing="True"
             VirtualizingPanel.VirtualizationMode="Recycling"
             VirtualizingPanel.ScrollUnit="Pixel"
             SizeChanged="GalleryList_SizeChanged">
        <ListBox.ItemContainerStyle>
            <!-- Strip ListBoxItem chrome: we draw our own tile selection -->
            <Style TargetType="ListBoxItem">
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <ContentPresenter/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate>
            <DataTemplate>
                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="{Binding TileWidth}" Height="{Binding TileHeight}"
                                    Margin="4" CornerRadius="10" BorderThickness="3"
                                    Background="{DynamicResource BoePanelBrush}" Cursor="Hand"
                                    ToolTip="{Binding Name}"
                                    MouseLeftButtonDown="GalleryTile_MouseLeftButtonDown"
                                    PreviewMouseRightButtonDown="GalleryTile_PreviewMouseRightButtonDown">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                        <Style.Triggers>
                                            <!-- Deck gallery: the commander's tile is outlined
                                                 in gold (selection blue still wins, below). -->
                                            <DataTrigger Binding="{Binding IsCommander}" Value="True">
                                                <Setter Property="BorderBrush" Value="#C8A200"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="BorderBrush"
                                                        Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <!-- The picture: nothing drawn on it -->
                                    <Grid Grid.Row="0">
                                    <!-- Placeholder: card name until the image arrives
                                         (stays if offline). The image covers it. -->
                                    <TextBlock Text="{Binding Name}" TextWrapping="Wrap"
                                               TextAlignment="Center" FontSize="12"
                                               VerticalAlignment="Center" Margin="8"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    <!-- Set checklist: printings you don't own are dimmed. -->
                                    <Image Source="{Binding Image}" Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="HighQuality">
                                        <Image.Style>
                                            <Style TargetType="Image">
                                                <Setter Property="Opacity" Value="1"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDimmed}" Value="True">
                                                        <Setter Property="Opacity" Value="0.3"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Image.Style>
                                    </Image>
                                    <!-- "Scryfall Fail" (no picture): the card's name in its text box -->
                                    <Grid Visibility="{Binding IsNotFound, Converter={StaticResource BoolToVisibilityConverter}}"
                                          IsHitTestVisible="False">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="66*"/>
                                            <RowDefinition Height="25*"/>
                                            <RowDefinition Height="9*"/>
                                        </Grid.RowDefinitions>
                                        <Viewbox Grid.Row="1" Stretch="Uniform" StretchDirection="DownOnly" Margin="14,4,14,4">
                                            <TextBlock Text="{Binding Name}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="260"
                                                       FontSize="20" FontWeight="SemiBold" Foreground="#202020"/>
                                        </Viewbox>
                                    </Grid>
                                    </Grid>

                                    <!-- Under the picture: one column per finish. Price of one
                                         copy (hover: count × price = total), then the count;
                                         Edit pages put − / + around it. Gold = foil (F) / etched (E).
                                         Too many columns for a small card: the strip shrinks. -->
                                    <Viewbox Grid.Row="1" Height="{Binding StripHeight}"
                                             Stretch="Uniform" StretchDirection="DownOnly"
                                             HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <ItemsControl ItemsSource="{Binding Slots}" Focusable="False">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Rows="1"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="3,1,3,2" HorizontalAlignment="Center">
                                                        <TextBlock Text="{Binding PriceText}" ToolTip="{Binding PriceTip}"
                                                                   HorizontalAlignment="Center" FontSize="11" FontWeight="SemiBold"
                                                                   Margin="0,0,0,2">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsGold}" Value="True">
                                                                            <Setter Property="Foreground" Value="{DynamicResource BoeGoldBrush}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsUnlisted}" Value="True">
                                                                            <Setter Property="Foreground" Value="{DynamicResource BoeWarningBrush}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding PriceText}" Value="">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <!-- Amber box: a finish you have that Scryfall doesn't list (ISA-101: needs a look) -->
                                                        <Border CornerRadius="6" BorderThickness="1" Padding="2,0"
                                                                HorizontalAlignment="Center" MinWidth="40"
                                                                Background="#20808080"
                                                                ToolTip="{Binding CountTip}">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsUnlisted}" Value="True">
                                                                            <Setter Property="BorderBrush" Value="{DynamicResource BoeWarningBrush}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                                <Button Content="−" Style="{StaticResource SlotButton}"
                                                                        Click="SlotRemove_Click"
                                                                        Visibility="{Binding ShowEditButtons, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                                <TextBlock Text="{Binding CountText}" FontSize="12" FontWeight="Bold"
                                                                           VerticalAlignment="Center" TextAlignment="Center"
                                                                           MinWidth="22" Margin="2,2">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsGold}" Value="True">
                                                                                    <Setter Property="Foreground" Value="{DynamicResource BoeGoldBrush}"/>
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding IsUnlisted}" Value="True">
                                                                                    <Setter Property="Foreground" Value="{DynamicResource BoeWarningBrush}"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                                <Button Content="+" Style="{StaticResource SlotButton}"
                                                                        Click="SlotAdd_Click"
                                                                        Visibility="{Binding ShowEditButtons, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Viewbox>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DataTemplate>
        </ListBox.ItemTemplate>
    </ListBox>

    <!-- Downloads-in-progress pill (gallery image downloads) -->
    <Border Grid.Row="0" x:Name="DownloadsPill"
            Visibility="Collapsed" IsHitTestVisible="False"
            HorizontalAlignment="Center" VerticalAlignment="Bottom"
            Margin="0,0,0,16" CornerRadius="14" Padding="14,6"
            Background="#E0202020" BorderBrush="#60808080" BorderThickness="1">
        <TextBlock x:Name="DownloadsPillText" FontSize="12" Foreground="White"/>
    </Border>

        <!-- Card size slider -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,6,0,0">
            <TextBlock Text="Card size" VerticalAlignment="Center" Margin="0,0,8,0"
                       FontSize="12"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            <Slider x:Name="GallerySizeSlider" Width="220" VerticalAlignment="Center"
                    Minimum="120" Maximum="340" Value="180"
                    SmallChange="10" LargeChange="40"
                    ValueChanged="GallerySizeSlider_ValueChanged"/>
        </StackPanel>
    </Grid>
</UserControl>
