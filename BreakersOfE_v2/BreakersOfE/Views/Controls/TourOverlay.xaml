<UserControl x:Class="BreakersOfE.Views.Controls.TourOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Visibility="Collapsed" Focusable="True"
             SizeChanged="Overlay_SizeChanged">

    <!-- The Program Tour, over the whole main window: the window dimmed, the
         part being explained outlined in the accent color, and a box beside it.
         The transparent background keeps clicks from reaching the app meanwhile. -->
    <Grid Background="Transparent">
        <Path x:Name="Dim" Fill="#A0000000" IsHitTestVisible="False"/>

        <Border x:Name="Ring" BorderThickness="2" CornerRadius="6"
                HorizontalAlignment="Left" VerticalAlignment="Top"
                BorderBrush="{DynamicResource AccentFillColorDefaultBrush}"
                IsHitTestVisible="False" Visibility="Collapsed"/>

        <Border x:Name="Callout" Width="380"
                HorizontalAlignment="Left" VerticalAlignment="Top"
                Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{DynamicResource AccentFillColorDefaultBrush}" BorderThickness="1"
                CornerRadius="8" Padding="16,10,16,14">
            <StackPanel>
                <DockPanel>
                    <ui:Button x:Name="BtnClose" DockPanel.Dock="Right" Content="✕"
                               Appearance="Transparent" Padding="8,2" Margin="0,-2,-8,0"
                               Click="BtnClose_Click"
                               ToolTip="Close the tour (it shows again the next time BoE starts, unless Do Not Show Again is ticked)"/>
                    <TextBlock x:Name="StepText" Style="{StaticResource BoeHint}" VerticalAlignment="Center"/>
                </DockPanel>
                <TextBlock x:Name="TitleText" Style="{StaticResource BoeSectionTitle}" TextWrapping="Wrap" Margin="0,4,0,6"/>
                <TextBlock x:Name="BodyText" FontSize="14" TextWrapping="Wrap" LineHeight="21"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                <CheckBox x:Name="ChkDontShow" Content="Do Not Show Again" Margin="0,12,0,0"
                          ToolTip="Don't start the tour when BoE opens. Settings → Restart Tour shows it again."/>
                <DockPanel Margin="0,12,0,0" LastChildFill="False">
                    <ui:Button x:Name="BtnSkip" DockPanel.Dock="Left" Content="Skip Tour" Padding="10,4"
                               Appearance="Transparent" Click="BtnClose_Click"
                               ToolTip="Leave the tour now (it shows again the next time BoE starts, unless Do Not Show Again is ticked)"/>
                    <ui:Button x:Name="BtnNext" DockPanel.Dock="Right" Content="Next  ▶" Padding="10,4"
                               Appearance="Primary" Click="BtnNext_Click" Margin="6,0,0,0"
                               ToolTip="Next (→ or Enter)"/>
                    <ui:Button x:Name="BtnBack" DockPanel.Dock="Right" Content="◀  Back" Padding="10,4"
                               Click="BtnBack_Click" ToolTip="Back (←)"/>
                </DockPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
