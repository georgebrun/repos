<ui:FluentWindow x:Class="BreakersOfE.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:pages="clr-namespace:BreakersOfE.Views.Pages"
        xmlns:controls="clr-namespace:BreakersOfE.Views.Controls"
        Title="Breakers of E — v2.0"
        Width="1400" Height="900"
        MinWidth="1000" MinHeight="600"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica">

    <!--
    ═══════════════════════════════════════════════════════════
    MAIN WINDOW — fresh minimal shell.

    Left nav has one expandable "Card Pool" item. Clicking it
    reveals the seven pool tables as sub-items (bullets). Each
    sub-item navigates to the same PoolPage but passes a Tag
    identifying which table to load.

    "Update Database" is pinned to the footer so we can build
    a pool DB on first run.
    ═══════════════════════════════════════════════════════════
    -->

    <Grid>
        <!-- Title bar -->
        <ui:TitleBar x:Name="TitleBar"
                     Grid.Row="0"
                     Title="Breakers of E"
                     ShowMaximize="True"
                     ShowMinimize="True">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Resources/Icons/BreakersOfE.png" Width="16" Height="16"/>
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!-- Navigation sidebar + content area -->
        <ui:NavigationView x:Name="RootNavigation"
                           PaneDisplayMode="Left"
                           IsBackButtonVisible="Collapsed"
                           IsPaneToggleVisible="True"
                           OpenPaneLength="220"
                           Margin="0,40,0,0">

            <!-- ═══ GRID / GALLERY SWITCH (above the tree) ═══
                 App-wide: decides whether card pages show the grid or the
                 gallery. The highlighted side is the current mode. -->
            <ui:NavigationView.PaneHeader>
                <StackPanel>
                    <Grid>
                        <!-- Pane open: full two-sided switch -->
                        <Grid Margin="8,4,8,10"
                          Visibility="{Binding IsPaneOpen, ElementName=RootNavigation,
                                       Converter={StaticResource BoolToVisibilityConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ui:Button x:Name="BtnModeGrid" Grid.Column="0"
                                   Content="Grid" HorizontalAlignment="Stretch"
                                   Margin="0,0,2,0" Click="BtnModeGrid_Click"
                                   Icon="{ui:SymbolIcon Grid24}"
                                   ToolTip="Show cards in the data grid"/>
                            <ui:Button x:Name="BtnModeGallery" Grid.Column="1"
                                   Content="Gallery" HorizontalAlignment="Stretch"
                                   Margin="2,0,0,0" Click="BtnModeGallery_Click"
                                   Icon="{ui:SymbolIcon Image24}"
                                   ToolTip="Show cards as images"/>
                        </Grid>

                        <!-- Pane collapsed: one icon button showing the current
                         mode; click flips it. -->
                        <ui:Button x:Name="BtnModeCompact"
                               Width="36" Height="36" Padding="0"
                               HorizontalAlignment="Left" Margin="6,4,0,10"
                               Appearance="Primary"
                               Click="BtnModeCompact_Click"
                               Visibility="{Binding IsPaneOpen, ElementName=RootNavigation,
                                            Converter={StaticResource BoolToVisibilityConverter},
                                            ConverterParameter=Invert}"/>
                    </Grid>

                    <!-- ═══ SECTION ACCORDION (top) ═══
                     View / Edit section buttons. The open section's button sits
                     here with its items below it; a closed section's button
                     drops to the pane footer. The code-behind moves them. -->
                    <StackPanel x:Name="TopSections"
                            Visibility="{Binding IsPaneOpen, ElementName=RootNavigation,
                                         Converter={StaticResource BoolToVisibilityConverter}}">
                        <ui:Button x:Name="BtnSectionView" Content="View"
                               Icon="{ui:SymbolIcon ChevronDown24}"
                               Appearance="Transparent"
                               HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                               FontWeight="SemiBold" Margin="4,0,8,4"
                               Click="BtnSectionView_Click"
                               ToolTip="Look at the card pool, sets, collection, and decks (read-only)"/>
                    </StackPanel>
                </StackPanel>
            </ui:NavigationView.PaneHeader>

            <!-- ═══ PANE FOOTER: closed sections, then Update Database (always last) ═══ -->
            <ui:NavigationView.PaneFooter>
                <StackPanel>
                    <StackPanel x:Name="BottomSections"
                            Visibility="{Binding IsPaneOpen, ElementName=RootNavigation,
                                         Converter={StaticResource BoolToVisibilityConverter}}">
                        <ui:Button x:Name="BtnSectionEdit" Content="Edit"
                               Icon="{ui:SymbolIcon ChevronRight24}"
                               Appearance="Transparent"
                               HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                               FontWeight="SemiBold" Margin="4,4,8,4"
                               Click="BtnSectionEdit_Click"
                               ToolTip="Edit your collection and decks"/>
                    </StackPanel>

                    <!-- Keyword Dictionary: a reference, open in View or Edit alike -->
                    <ui:Button x:Name="BtnKeywordDictionary" Content="Keyword Dictionary"
                           Icon="{ui:SymbolIcon BookQuestionMark24}"
                           Appearance="Transparent"
                           HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                           Margin="4,4,8,0"
                           Click="BtnKeywordDictionary_Click"
                           ToolTip="Look up any keyword: what it means, the official rules, and the cards that have it"
                           Visibility="{Binding IsPaneOpen, ElementName=RootNavigation,
                                        Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <ui:Button Width="36" Height="36" Padding="0"
                           HorizontalAlignment="Left" Margin="6,4,0,0"
                           Appearance="Transparent"
                           Icon="{ui:SymbolIcon BookQuestionMark24}"
                           Click="BtnKeywordDictionary_Click"
                           ToolTip="Keyword Dictionary"
                           Visibility="{Binding IsPaneOpen, ElementName=RootNavigation,
                                        Converter={StaticResource BoolToVisibilityConverter},
                                        ConverterParameter=Invert}"/>

                    <!-- Help: its own window, so it can stay open beside the app -->
                    <ui:Button x:Name="BtnHelp" Content="Help"
                           Icon="{ui:SymbolIcon QuestionCircle24}"
                           Appearance="Transparent"
                           HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                           Margin="4,4,8,0"
                           Click="BtnHelp_Click"
                           ToolTip="How BoE works, step-by-step how-tos, and keyboard shortcuts (F1: help for the page you're on)"
                           Visibility="{Binding IsPaneOpen, ElementName=RootNavigation,
                                        Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <ui:Button Width="36" Height="36" Padding="0"
                           HorizontalAlignment="Left" Margin="6,4,0,0"
                           Appearance="Transparent"
                           Icon="{ui:SymbolIcon QuestionCircle24}"
                           Click="BtnHelp_Click"
                           ToolTip="Help"
                           Visibility="{Binding IsPaneOpen, ElementName=RootNavigation,
                                        Converter={StaticResource BoolToVisibilityConverter},
                                        ConverterParameter=Invert}"/>

                    <!-- Settings -->
                    <ui:Button x:Name="BtnSettings" Content="Settings"
                           Icon="{ui:SymbolIcon Settings24}"
                           Appearance="Transparent"
                           HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                           Margin="4,4,8,0"
                           Click="BtnSettings_Click"
                           ToolTip="Defaults, card pictures, startup, data folder"
                           Visibility="{Binding IsPaneOpen, ElementName=RootNavigation,
                                        Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <ui:Button Width="36" Height="36" Padding="0"
                           HorizontalAlignment="Left" Margin="6,4,0,0"
                           Appearance="Transparent"
                           Icon="{ui:SymbolIcon Settings24}"
                           Click="BtnSettings_Click"
                           ToolTip="Settings"
                           Visibility="{Binding IsPaneOpen, ElementName=RootNavigation,
                                        Converter={StaticResource BoolToVisibilityConverter},
                                        ConverterParameter=Invert}"/>

                    <!-- Card data getting old (Settings → Remind me to update): amber, click to update -->
                    <StackPanel Visibility="{Binding IsPaneOpen, ElementName=RootNavigation,
                                             Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock x:Name="UpdateReminder" Margin="14,8,8,0" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{DynamicResource BoeWarningBrush}" Cursor="Hand" Visibility="Collapsed"
                                   MouseLeftButtonUp="UpdateReminder_Click"
                                   ToolTip="Click to update the card database and prices"/>
                    </StackPanel>

                    <!-- Update Database: always the very last thing in the pane.
                     A plain button (not a tree item) so nothing can sit below it. -->
                    <ui:Button x:Name="BtnUpdateDatabase" Content="Update Database"
                           Icon="{ui:SymbolIcon ArrowDownload24}"
                           Appearance="Transparent"
                           HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                           Margin="4,4,8,8"
                           Click="BtnUpdateDatabase_Click"
                           ToolTip="Download card data and prices from Scryfall"
                           Visibility="{Binding IsPaneOpen, ElementName=RootNavigation,
                                        Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <!-- Pane collapsed: icon only -->
                    <ui:Button Width="36" Height="36" Padding="0"
                           HorizontalAlignment="Left" Margin="6,4,0,8"
                           Appearance="Transparent"
                           Icon="{ui:SymbolIcon ArrowDownload24}"
                           Click="BtnUpdateDatabase_Click"
                           ToolTip="Update Database"
                           Visibility="{Binding IsPaneOpen, ElementName=RootNavigation,
                                        Converter={StaticResource BoolToVisibilityConverter},
                                        ConverterParameter=Invert}"/>
                </StackPanel>
            </ui:NavigationView.PaneFooter>

            <ui:NavigationView.MenuItems>

                <!-- ═══ VIEW section items (shown while View is open) ═══ -->

                <!-- ═══ CARD POOL (expandable) ═══ -->
                <ui:NavigationViewItem x:Name="NavCardPool" Content="Card Pool"
                                       Icon="{ui:SymbolIcon Library24}"
                                       IsExpanded="True">

                    <ui:NavigationViewItem.MenuItems>

                        <ui:NavigationViewItem Content="Cards"
                                               Tag="Cards"
                                               TargetPageTag="pool-cards"
                                               TargetPageType="{x:Type pages:PoolPage}"
                                               Icon="{ui:SymbolIcon Grid24}" />

                        <ui:NavigationViewItem Content="Tokens"
                                               Tag="Tokens"
                                               TargetPageType="{x:Type pages:PoolPage}"
                                               Icon="{ui:SymbolIcon Star24}" />

                        <ui:NavigationViewItem Content="Planes"
                                               Tag="Planes"
                                               TargetPageType="{x:Type pages:PoolPage}"
                                               Icon="{ui:SymbolIcon Globe24}" />

                        <ui:NavigationViewItem Content="Schemes"
                                               Tag="Schemes"
                                               TargetPageType="{x:Type pages:PoolPage}"
                                               Icon="{ui:SymbolIcon Flowchart24}" />

                        <ui:NavigationViewItem Content="Vanguards"
                                               Tag="Vanguards"
                                               TargetPageType="{x:Type pages:PoolPage}"
                                               Icon="{ui:SymbolIcon Person24}" />

                        <ui:NavigationViewItem Content="Art Series"
                                               Tag="ArtSeries"
                                               TargetPageType="{x:Type pages:PoolPage}"
                                               Icon="{ui:SymbolIcon Image24}" />

                        <ui:NavigationViewItem Content="Conspiracies"
                                               Tag="Conspiracies"
                                               TargetPageType="{x:Type pages:PoolPage}"
                                               Icon="{ui:SymbolIcon EyeTracking24}" />

                        <ui:NavigationViewItem Content="Oversized"
                                               Tag="Oversized"
                                               TargetPageType="{x:Type pages:PoolPage}"
                                               Icon="{ui:SymbolIcon FullScreenMaximize24}" />

                        <ui:NavigationViewItem Content="Front Cards"
                                               Tag="FrontCards"
                                               TargetPageType="{x:Type pages:PoolPage}"
                                               Icon="{ui:SymbolIcon Tag24}" />

                    </ui:NavigationViewItem.MenuItems>
                </ui:NavigationViewItem>

                <!-- ═══ SETS (set browser over the Cards pool) ═══ -->
                <ui:NavigationViewItem x:Name="NavSets" Content="Sets"
                                       Tag="Sets"
                                       TargetPageTag="view-sets"
                                       TargetPageType="{x:Type pages:PoolPage}"
                                       Icon="{ui:SymbolIcon Layer24}" />

                <!-- ═══ COLLECTION (expandable; changes are made under Edit) ═══
                     Same sub-items as the Card Pool, plus Trade Binder and Want List.
                     "Collection" stays the main collection's tag (saved layouts/filters). -->
                <ui:NavigationViewItem x:Name="NavCollection" Content="Collection"
                                       Icon="{ui:SymbolIcon Folder24}"
                                       IsExpanded="False">

                    <ui:NavigationViewItem.MenuItems>

                        <ui:NavigationViewItem Content="Cards"
                                               Tag="Collection"
                                               TargetPageTag="coll-cards"
                                               TargetPageType="{x:Type pages:PoolPage}"
                                               Icon="{ui:SymbolIcon Grid24}" />

                        <ui:NavigationViewItem Content="Tokens"
                                               Tag="CollTokens"
                                               TargetPageType="{x:Type pages:PoolPage}"
                                               Icon="{ui:SymbolIcon Star24}" />

                        <ui:NavigationViewItem Content="Planes"
                                               Tag="CollPlanes"
                                               TargetPageType="{x:Type pages:PoolPage}"
                                               Icon="{ui:SymbolIcon Globe24}" />

                        <ui:NavigationViewItem Content="Schemes"
                                               Tag="CollSchemes"
                                               TargetPageType="{x:Type pages:PoolPage}"
                                               Icon="{ui:SymbolIcon Flowchart24}" />

                        <ui:NavigationViewItem Content="Vanguards"
                                               Tag="CollVanguards"
                                               TargetPageType="{x:Type pages:PoolPage}"
                                               Icon="{ui:SymbolIcon Person24}" />

                        <ui:NavigationViewItem Content="Art Series"
                                               Tag="CollArtSeries"
                                               TargetPageType="{x:Type pages:PoolPage}"
                                               Icon="{ui:SymbolIcon Image24}" />

                        <ui:NavigationViewItem Content="Conspiracies"
                                               Tag="CollConspiracies"
                                               TargetPageType="{x:Type pages:PoolPage}"
                                               Icon="{ui:SymbolIcon EyeTracking24}" />

                        <ui:NavigationViewItem Content="Oversized"
                                               Tag="CollOversized"
                                               TargetPageType="{x:Type pages:PoolPage}"
                                               Icon="{ui:SymbolIcon FullScreenMaximize24}" />

                        <ui:NavigationViewItem Content="Front Cards"
                                               Tag="CollFrontCards"
                                               TargetPageType="{x:Type pages:PoolPage}"
                                               Icon="{ui:SymbolIcon Tag24}" />

                        <ui:NavigationViewItem Content="Trade Binder"
                                               Tag="TradeBinder"
                                               TargetPageType="{x:Type pages:PoolPage}"
                                               Icon="{ui:SymbolIcon BookOpen24}" />

                        <ui:NavigationViewItem Content="Want List"
                                               Tag="WantList"
                                               TargetPageType="{x:Type pages:PoolPage}"
                                               Icon="{ui:SymbolIcon List24}" />

                    </ui:NavigationViewItem.MenuItems>
                </ui:NavigationViewItem>

                <!-- ═══ DECKS (deck browser → open a deck; changes are made under Edit → Decks) ═══ -->
                <ui:NavigationViewItem x:Name="NavDecks" Content="Decks"
                                       Tag="Decks"
                                       TargetPageTag="view-decks"
                                       TargetPageType="{x:Type pages:PoolPage}"
                                       Icon="{ui:SymbolIcon Stack24}" />

                <!-- ═══ ONLINE (expandable): Magic Online and MTG Arena, each with its
                     own card pool and its own collection — never mixed with paper. ═══ -->
                <ui:NavigationViewItem x:Name="NavOnline" Content="Online"
                                       Icon="{ui:SymbolIcon Cloud24}"
                                       IsExpanded="False">
                    <ui:NavigationViewItem.MenuItems>
                        <ui:NavigationViewItem Content="MTGO Cards"
                                               Tag="MtgoCards"
                                               TargetPageType="{x:Type pages:PoolPage}"
                                               Icon="{ui:SymbolIcon Desktop24}" />
                        <ui:NavigationViewItem Content="MTGO Collection"
                                               Tag="MtgoCollection"
                                               TargetPageType="{x:Type pages:PoolPage}"
                                               Icon="{ui:SymbolIcon Folder24}" />
                        <ui:NavigationViewItem Content="Arena Cards"
                                               Tag="ArenaCards"
                                               TargetPageType="{x:Type pages:PoolPage}"
                                               Icon="{ui:SymbolIcon Games24}" />
                        <ui:NavigationViewItem Content="Arena Collection"
                                               Tag="ArenaCollection"
                                               TargetPageType="{x:Type pages:PoolPage}"
                                               Icon="{ui:SymbolIcon Folder24}" />
                    </ui:NavigationViewItem.MenuItems>
                </ui:NavigationViewItem>

                <!-- ═══ EDIT section items (shown while Edit is open) ═══ -->

                <!-- Pool → Collection: pool table on top, its collection table below -->
                <ui:NavigationViewItem x:Name="NavEditPoolToCollection" Content="Pool → Collection"
                                       Icon="{ui:SymbolIcon Edit24}"
                                       Visibility="Collapsed"
                                       IsExpanded="True">
                    <ui:NavigationViewItem.MenuItems>
                        <ui:NavigationViewItem Content="Cards"
                                               Tag="Edit:Cards"
                                               TargetPageType="{x:Type pages:EditCollectionPage}"
                                               Icon="{ui:SymbolIcon Grid24}" />

                        <ui:NavigationViewItem Content="Tokens"
                                               Tag="Edit:Tokens"
                                               TargetPageType="{x:Type pages:EditCollectionPage}"
                                               Icon="{ui:SymbolIcon Star24}" />

                        <ui:NavigationViewItem Content="Planes"
                                               Tag="Edit:Planes"
                                               TargetPageType="{x:Type pages:EditCollectionPage}"
                                               Icon="{ui:SymbolIcon Globe24}" />

                        <ui:NavigationViewItem Content="Schemes"
                                               Tag="Edit:Schemes"
                                               TargetPageType="{x:Type pages:EditCollectionPage}"
                                               Icon="{ui:SymbolIcon Flowchart24}" />

                        <ui:NavigationViewItem Content="Vanguards"
                                               Tag="Edit:Vanguards"
                                               TargetPageType="{x:Type pages:EditCollectionPage}"
                                               Icon="{ui:SymbolIcon Person24}" />

                        <ui:NavigationViewItem Content="Art Series"
                                               Tag="Edit:ArtSeries"
                                               TargetPageType="{x:Type pages:EditCollectionPage}"
                                               Icon="{ui:SymbolIcon Image24}" />

                        <ui:NavigationViewItem Content="Conspiracies"
                                               Tag="Edit:Conspiracies"
                                               TargetPageType="{x:Type pages:EditCollectionPage}"
                                               Icon="{ui:SymbolIcon EyeTracking24}" />

                        <ui:NavigationViewItem Content="Oversized"
                                               Tag="Edit:Oversized"
                                               TargetPageType="{x:Type pages:EditCollectionPage}"
                                               Icon="{ui:SymbolIcon FullScreenMaximize24}" />

                        <ui:NavigationViewItem Content="Front Cards"
                                               Tag="Edit:FrontCards"
                                               TargetPageType="{x:Type pages:EditCollectionPage}"
                                               Icon="{ui:SymbolIcon Tag24}" />

                    </ui:NavigationViewItem.MenuItems>
                </ui:NavigationViewItem>

                <!-- Decks: build and change decks (pool on top, the deck below) -->
                <ui:NavigationViewItem x:Name="NavEditDecks" Content="Decks"
                                       Icon="{ui:SymbolIcon Layer24}"
                                       Visibility="Collapsed"
                                       IsExpanded="True">
                    <ui:NavigationViewItem.MenuItems>
                        <ui:NavigationViewItem Content="Pool → Deck"
                                               Tag="EditDeck:Pool"
                                               TargetPageType="{x:Type pages:EditDeckPage}"
                                               Icon="{ui:SymbolIcon ArrowRight24}" />
                        <ui:NavigationViewItem Content="Collection → Deck"
                                               Tag="EditDeck:Collection"
                                               TargetPageType="{x:Type pages:EditDeckPage}"
                                               Icon="{ui:SymbolIcon ArrowRight24}" />
                        <ui:NavigationViewItem Content="Deck → Collection"
                                               Tag="EditDeck:DeckToCollection"
                                               TargetPageTag="editdeck-d2c"
                                               TargetPageType="{x:Type pages:EditDeckPage}"
                                               Icon="{ui:SymbolIcon ArrowLeft24}" />
                    </ui:NavigationViewItem.MenuItems>
                </ui:NavigationViewItem>

                <!-- Lists: the Trade Binder and the Want List -->
                <ui:NavigationViewItem x:Name="NavEditLists" Content="Lists"
                                       Icon="{ui:SymbolIcon BookOpen24}"
                                       Visibility="Collapsed"
                                       IsExpanded="True">
                    <ui:NavigationViewItem.MenuItems>
                        <ui:NavigationViewItem Content="Collection → Trade Binder"
                                               Tag="EditList:TradeBinder"
                                               TargetPageType="{x:Type pages:EditTradeBinderPage}"
                                               Icon="{ui:SymbolIcon ArrowRight24}" />
                        <ui:NavigationViewItem Content="Pool → Want List"
                                               Tag="EditList:WantList"
                                               TargetPageType="{x:Type pages:EditWantListPage}"
                                               Icon="{ui:SymbolIcon ArrowRight24}" />
                    </ui:NavigationViewItem.MenuItems>
                </ui:NavigationViewItem>

                <!-- Import / Export: card lists in and out (other apps, MTG Deck Tools, BoE's own full file) -->
                <ui:NavigationViewItem x:Name="NavEditImport" Content="Import / Export"
                                       Tag="EditImport"
                                       TargetPageType="{x:Type pages:ImportExportPage}"
                                       Visibility="Collapsed"
                                       Icon="{ui:SymbolIcon Folder24}" />

                <!-- Online → Collection: the MTGO or Arena pool on top, that game's collection below -->
                <ui:NavigationViewItem x:Name="NavEditOnline" Content="Online → Collection"
                                       Icon="{ui:SymbolIcon Cloud24}"
                                       Visibility="Collapsed"
                                       IsExpanded="True">
                    <ui:NavigationViewItem.MenuItems>
                        <ui:NavigationViewItem Content="MTGO"
                                               Tag="Edit:MtgoCards"
                                               TargetPageType="{x:Type pages:EditCollectionPage}"
                                               Icon="{ui:SymbolIcon Desktop24}" />
                        <ui:NavigationViewItem Content="Arena"
                                               Tag="Edit:ArenaCards"
                                               TargetPageType="{x:Type pages:EditCollectionPage}"
                                               Icon="{ui:SymbolIcon Games24}" />
                    </ui:NavigationViewItem.MenuItems>
                </ui:NavigationViewItem>

            </ui:NavigationView.MenuItems>

            <!-- ═══ FOOTER ═══ -->

        </ui:NavigationView>

        <!-- The Program Tour: over everything but the title bar (the window can still be moved or closed) -->
        <controls:TourOverlay x:Name="Tour" Margin="0,40,0,0" Panel.ZIndex="100"/>
    </Grid>

</ui:FluentWindow>
