<ui:FluentWindow x:Class="BreakersOfE.Views.CardDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="{Binding ElementName=CardName, Path=Text}"
        Width="780" Height="680"
        MinWidth="500" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ExtendsContentIntoTitleBar="False">

    <ui:FluentWindow.Resources>
        <Style x:Key="DLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
            <Setter Property="Margin" Value="0,8,0,1"/>
        </Style>
        <Style x:Key="DValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </ui:FluentWindow.Resources>

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ═══ LEFT: Large card image ═══ -->
        <StackPanel Grid.Column="0" VerticalAlignment="Top" Margin="0,0,20,0">
            <Border CornerRadius="12" Background="#20808080" MaxWidth="340">
                <Image x:Name="CardImage" Stretch="Uniform"
                       MaxHeight="480"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
            </Border>
            <Button x:Name="BtnFlipFace" Content="🔄 Show Back Face"
                    HorizontalAlignment="Center" Margin="0,8,0,0"
                    Padding="10,5" FontSize="12"
                    Visibility="Collapsed"
                    Click="BtnFlipFace_Click"/>
        </StackPanel>

        <!-- ═══ RIGHT: Card details ═══ -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock x:Name="CardName" Style="{StaticResource DValue}"
                           FontSize="22" FontWeight="Bold" Margin="0,0,0,4"/>

                <TextBlock Text="MANA COST" Style="{StaticResource DLabel}"/>
                <ItemsControl x:Name="ManaCostPanel">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <TextBlock Text="TYPE" Style="{StaticResource DLabel}"/>
                <TextBlock x:Name="CardType" Style="{StaticResource DValue}"/>

                <TextBlock Text="SET" Style="{StaticResource DLabel}"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                    <Image x:Name="SetSymbol" Width="18" Height="18"
                           Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="CardSet" Style="{StaticResource DValue}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock Text="COLLECTOR NUMBER" Style="{StaticResource DLabel}"/>
                <TextBlock x:Name="CardCollectorNumber" Style="{StaticResource DValue}"/>

                <TextBlock Text="RARITY" Style="{StaticResource DLabel}"/>
                <TextBlock x:Name="CardRarity" Style="{StaticResource DValue}"/>

                <TextBlock x:Name="PTLabel" Text="POWER / TOUGHNESS" Style="{StaticResource DLabel}"/>
                <TextBlock x:Name="CardPT" Style="{StaticResource DValue}"/>

                <TextBlock Text="ORACLE TEXT" Style="{StaticResource DLabel}"/>
                <TextBlock x:Name="CardOracle" Style="{StaticResource DValue}"
                           FontSize="13"/>

                <TextBlock Text="FLAVOR TEXT" Style="{StaticResource DLabel}"/>
                <TextBlock x:Name="CardFlavor" Style="{StaticResource DValue}"
                           FontSize="13" FontStyle="Italic" Opacity="0.7"/>

                <TextBlock Text="ARTIST" Style="{StaticResource DLabel}"/>
                <TextBlock x:Name="CardArtist" Style="{StaticResource DValue}"/>

                <TextBlock Text="AVAILABLE AS" Style="{StaticResource DLabel}"/>
                <TextBlock x:Name="CardFinishes" Style="{StaticResource DValue}"/>

                <TextBlock Text="PRICES (USD)" Style="{StaticResource DLabel}"/>
                <TextBlock x:Name="CardPrices" Style="{StaticResource DValue}" FontSize="13"/>

                <Button Content="Close" HorizontalAlignment="Right"
                        Margin="0,16,0,0" Padding="16,6"
                        Click="BtnClose_Click"/>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</ui:FluentWindow>
