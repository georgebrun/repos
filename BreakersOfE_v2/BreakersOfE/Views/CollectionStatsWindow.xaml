<ui:FluentWindow x:Class="BreakersOfE.Views.CollectionStatsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Collection Statistics"
        Width="1000" Height="780"
        MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ExtendsContentIntoTitleBar="True">

    <ui:FluentWindow.Resources>
        <!-- Section heading -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
        </Style>

        <!-- One summary number (big value + small label) -->
        <DataTemplate x:Key="SummaryTile">
            <Border Width="170" Margin="0,0,10,10" Padding="12,10" CornerRadius="8"
                    Background="#18808080">
                <StackPanel>
                    <TextBlock Text="{Binding Value}" FontSize="20" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <TextBlock Text="{Binding Label}" FontSize="12" Margin="0,2,0,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- One bar row: label · bar (by card count) · count · value -->
        <DataTemplate x:Key="BarRow">
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="90"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Label}"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                <Border Grid.Column="1" Height="14" Background="#20808080" CornerRadius="3"
                        VerticalAlignment="Center" Margin="0,0,8,0" ClipToBounds="True">
                    <Border HorizontalAlignment="Left" CornerRadius="3" Background="#4CA0FF"
                            Width="{Binding BarWidth}"/>
                </Border>
                <TextBlock Grid.Column="2" Text="{Binding CountText}" TextAlignment="Right"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                <TextBlock Grid.Column="3" Text="{Binding ValueText}" TextAlignment="Right"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            </Grid>
        </DataTemplate>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title bar: drag to move, minimize / maximize / close (X) -->
        <ui:TitleBar Grid.Row="0" Title="Collection Statistics"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16,4,16,0">
            <StackPanel>
                <TextBlock x:Name="ScopeText" FontSize="13" Margin="0,0,0,10"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

                <!-- Summary numbers -->
                <ItemsControl x:Name="SummaryList" ItemTemplate="{StaticResource SummaryTile}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <!-- Breakdowns, two per row -->
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,20">
                        <TextBlock Text="By color" Style="{StaticResource SectionHeader}"/>
                        <ItemsControl x:Name="ColorBars" ItemTemplate="{StaticResource BarRow}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,20">
                        <TextBlock Text="By rarity" Style="{StaticResource SectionHeader}"/>
                        <ItemsControl x:Name="RarityBars" ItemTemplate="{StaticResource BarRow}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,20">
                        <TextBlock Text="By card type" Style="{StaticResource SectionHeader}"/>
                        <ItemsControl x:Name="TypeBars" ItemTemplate="{StaticResource BarRow}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,20">
                        <TextBlock Text="Top sets by value" Style="{StaticResource SectionHeader}"/>
                        <ItemsControl x:Name="SetBars" ItemTemplate="{StaticResource BarRow}"/>
                    </StackPanel>
                </Grid>

                <!-- Most valuable cards -->
                <TextBlock Text="Most valuable cards" Style="{StaticResource SectionHeader}"/>
                <DataGrid x:Name="TopCardsGrid" Margin="0,0,0,16"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" GridLinesVisibility="None"
                          RowHeaderWidth="0" RowHeight="26"
                          CanUserSortColumns="True" CanUserReorderColumns="False"
                          ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name"   Binding="{Binding Name}"            Width="*"/>
                        <DataGridTextColumn Header="Set"    Binding="{Binding SetName}"         Width="200"/>
                        <DataGridTextColumn Header="Finish" Binding="{Binding FinishPill}"      Width="70">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#FFC000"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Qty"    Binding="{Binding Quantity}"        Width="60"/>
                        <DataGridTextColumn Header="Price"  Binding="{Binding PriceDisplay}"    Width="90" SortMemberPath="Price"/>
                        <DataGridTextColumn Header="Value"  Binding="{Binding RowValueDisplay}" Width="90" SortMemberPath="RowValue"/>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </ScrollViewer>

        <DockPanel Grid.Row="2" Margin="16,8,16,16" LastChildFill="True">
            <Button DockPanel.Dock="Right" Content="Close" Padding="16,5" Click="BtnClose_Click"/>
            <TextBlock FontSize="12" Opacity="0.7" VerticalAlignment="Center" TextWrapping="Wrap"
                       Margin="0,0,12,0"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="Bars show card counts; the right-hand number is value (price × quantity). Lands count under Land, not their color. A card counts once in Type (Artifact Creature → Creature)."/>
        </DockPanel>
    </Grid>
</ui:FluentWindow>
