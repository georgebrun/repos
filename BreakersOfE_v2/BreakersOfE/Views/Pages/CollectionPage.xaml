<Page x:Class="BreakersOfE.Views.Pages.CollectionPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:dgx="clr-namespace:DataGridExtensions;assembly=DataGridExtensions"
      xmlns:svc="clr-namespace:BreakersOfE.Services"
      xmlns:vm="clr-namespace:BreakersOfE.ViewModels"
      ScrollViewer.VerticalScrollBarVisibility="Disabled">

    <Page.DataContext>
        <vm:CollectionViewModel />
    </Page.DataContext>

    <Page.Resources>
        <svc:BoolToGreenRedConverter x:Key="BoolToGreenRedConverter" />
        <svc:ImageSourceConverter x:Key="ImageSourceConverter" />
        <svc:ManaCostConverter x:Key="ManaCostConverter" />
    </Page.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!-- Header row: title + search -->
            <RowDefinition Height="*" />
            <!-- Pool DataGrid -->
            <RowDefinition Height="Auto" />
            <!-- Status bar -->
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════════════════════════
             HEADER: Mode selector + Search bar + Refresh
             ═══════════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Mode selector -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Collection" FontSize="22" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="0,0,16,0" />
                <ComboBox ItemsSource="{Binding AvailableModes}"
                          SelectedItem="{Binding SelectedMode}"
                          Width="220" VerticalAlignment="Center" />
            </StackPanel>

            <!-- Search bar — begins-with, scroll-to, NEVER filters rows -->
            <StackPanel Grid.Column="1" Orientation="Horizontal"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Margin="16,0,16,0">
                <TextBlock Text="Search:" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBox x:Name="SearchBox" Width="220" VerticalAlignment="Center"
                         TextChanged="SearchBox_TextChanged" />
            </StackPanel>

            <!-- Refresh button -->
            <Button Grid.Column="2" Content="⟳ Refresh"
                    Command="{Binding RefreshCommand}"
                    VerticalAlignment="Center" Padding="12,6" />
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════════
             POOL DATAGRID — binds directly to PoolCard
             DataGridExtensions adds Excel-like column header filters
             ═══════════════════════════════════════════════════════════════ -->
        <DataGrid Grid.Row="1"
                  x:Name="PoolGrid"
                  ItemsSource="{Binding PoolCards}"
                  SelectedItem="{Binding SelectedPoolCard}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  HeadersVisibility="Column"
                  GridLinesVisibility="None"
                  RowHeaderWidth="0"
                  RowHeight="28"
                  CanUserResizeColumns="True"
                  CanUserReorderColumns="True"
                  CanUserSortColumns="True"
                  EnableRowVirtualization="True"
                  EnableColumnVirtualization="True"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  ScrollViewer.CanContentScroll="True"
                  RowDetailsVisibilityMode="Collapsed"
                  dgx:DataGridFilter.IsAutoFilterEnabled="False">

            <!-- Row style — color-coded by color identity (same as v1) -->
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="Foreground" Value="{Binding RowForegroundBrush}" />
                    <Setter Property="Background" Value="{Binding RowBackgroundBrush}" />
                </Style>
            </DataGrid.RowStyle>

            <!-- Context menu — same actions as v1 -->
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Add to Collection (Non-Foil)"
                              Command="{Binding DataContext.AddToCollectionCommand,
                                        RelativeSource={RelativeSource AncestorType=Page}}" />
                    <MenuItem Header="Add to Collection (Foil)"
                              Command="{Binding DataContext.AddToCollectionFoilCommand,
                                        RelativeSource={RelativeSource AncestorType=Page}}" />
                    <Separator />
                    <MenuItem Header="Add to Trade Binder"
                              Command="{Binding DataContext.AddToTradeBinderCommand,
                                        RelativeSource={RelativeSource AncestorType=Page}}" />
                    <MenuItem Header="Add to Want List"
                              Command="{Binding DataContext.AddToWantListCommand,
                                        RelativeSource={RelativeSource AncestorType=Page}}" />
                </ContextMenu>
            </DataGrid.ContextMenu>

            <!-- ── Columns — bound directly to PoolCard properties ──── -->
            <DataGrid.Columns>

                <!-- Set symbol icon -->
                <DataGridTemplateColumn Header="ES" Width="32" CanUserResize="False"
                                        dgx:DataGridFilterColumn.IsFilterVisible="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Image Source="{Binding SetSymbolPath,
                                            Converter={StaticResource ImageSourceConverter}}"
                                   Width="16" Height="16"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Legality pills: S M P L V -->
                <DataGridTemplateColumn Header="Legal" Width="100"
                                        dgx:DataGridFilterColumn.IsFilterVisible="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Center" Margin="2,0">
                                <Border CornerRadius="3" Margin="1,0" Padding="3,1"
                                        Background="{Binding IsLegalStandard,
                                                     Converter={StaticResource BoolToGreenRedConverter}}">
                                    <TextBlock Text="S" FontSize="10" FontWeight="Bold" Foreground="White" />
                                </Border>
                                <Border CornerRadius="3" Margin="1,0" Padding="3,1"
                                        Background="{Binding IsLegalModern,
                                                     Converter={StaticResource BoolToGreenRedConverter}}">
                                    <TextBlock Text="M" FontSize="10" FontWeight="Bold" Foreground="White" />
                                </Border>
                                <Border CornerRadius="3" Margin="1,0" Padding="3,1"
                                        Background="{Binding IsLegalPioneer,
                                                     Converter={StaticResource BoolToGreenRedConverter}}">
                                    <TextBlock Text="P" FontSize="10" FontWeight="Bold" Foreground="White" />
                                </Border>
                                <Border CornerRadius="3" Margin="1,0" Padding="3,1"
                                        Background="{Binding IsLegalLegacy,
                                                     Converter={StaticResource BoolToGreenRedConverter}}">
                                    <TextBlock Text="L" FontSize="10" FontWeight="Bold" Foreground="White" />
                                </Border>
                                <Border CornerRadius="3" Margin="1,0" Padding="3,1"
                                        Background="{Binding IsLegalVintage,
                                                     Converter={StaticResource BoolToGreenRedConverter}}">
                                    <TextBlock Text="V" FontSize="10" FontWeight="Bold" Foreground="White" />
                                </Border>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Name"         Binding="{Binding Name}"            Width="200" />
                <DataGridTextColumn Header="Foil"         Binding="{Binding IsFoil}"          Width="40" />
                <DataGridTextColumn Header="Non-Foil"     Binding="{Binding IsNonFoil}"       Width="60" />
                <DataGridTextColumn Header="Edition"      Binding="{Binding SetCode}"         Width="55" />
                <DataGridTextColumn Header="Edition Name" Binding="{Binding SetName}"         Width="160" />
                <DataGridTextColumn Header="Color"        Binding="{Binding ColorDisplay}"    Width="50" />
                <DataGridTextColumn Header="Type"         Binding="{Binding TypeLine}"        Width="180" />
                <DataGridTextColumn Header="Rarity"       Binding="{Binding RarityCode}"      Width="50" />

                <!-- Mana cost with symbol rendering -->
                <DataGridTemplateColumn Header="Cost" Width="110"
                                        dgx:DataGridFilterColumn.IsFilterVisible="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ContentPresenter Content="{Binding ManaCost,
                                              Converter={StaticResource ManaCostConverter}}"
                                              VerticalAlignment="Center" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="P/T"          Binding="{Binding PowerToughness}"  Width="55" />
                <DataGridTextColumn Header="USD"          Binding="{Binding PriceUsdDisplay}" Width="65" />
                <DataGridTextColumn Header="Foil $"       Binding="{Binding PriceUsdFoilDisplay}" Width="65" />
                <DataGridTextColumn Header="Text"         Binding="{Binding OracleText}"      Width="220" />
                <DataGridTextColumn Header="Flavor"       Binding="{Binding FlavorText}"      Width="160" />
                <DataGridTextColumn Header="Artist"       Binding="{Binding Artist}"          Width="130" />
                <DataGridTextColumn Header="No"           Binding="{Binding CollectorNumber}" Width="55" />
                <DataGridTextColumn Header="Power"        Binding="{Binding Power}"           Width="50" />
                <DataGridTextColumn Header="Toughness"    Binding="{Binding Toughness}"       Width="70" />
                <DataGridTextColumn Header="CMC"          Binding="{Binding ManaValue}"       Width="45" />

            </DataGrid.Columns>
        </DataGrid>

        <!-- ═══════════════════════════════════════════════════════════════
             STATUS BAR + LOADING OVERLAY
             ═══════════════════════════════════════════════════════════════ -->
        <TextBlock Grid.Row="2" Text="{Binding PoolStatusText}"
                   FontSize="13" Opacity="0.7" Margin="0,6,0,0" />

        <!-- Loading overlay — covers the grid while loading -->
        <Border Grid.Row="1"
                Background="#80000000"
                Visibility="{Binding IsLoading,
                             Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ui:ProgressRing IsIndeterminate="True" Width="48" Height="48" />
                <TextBlock Text="{Binding LoadingText}"
                           Foreground="White" FontSize="14"
                           HorizontalAlignment="Center" Margin="0,12,0,0" />
            </StackPanel>
        </Border>

    </Grid>
</Page>
