<Page x:Class="BreakersOfE.Views.Pages.EditBuildPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ctl="clr-namespace:BreakersOfE.Views.Controls"
      ScrollViewer.VerticalScrollBarVisibility="Disabled"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <!-- Edit → Decks → Build: tell the builder what you want (left of the
         draft), Build Draft, look it over (every card with its reason), lock or
         exclude cards and build again, then Accept: a new deck, your free copies
         claimed, the rest on the Want List for it. -->
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="DetailColumn" Width="240" MinWidth="180" MaxWidth="480"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*" MinWidth="300"/>
        </Grid.ColumnDefinitions>

        <!-- ═══ LEFT: the card selected in the draft ═══ -->
        <ctl:CardDetailPanel x:Name="Detail" Grid.Column="0" Margin="0,0,4,0"/>

        <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                      Background="Transparent" Cursor="SizeWE" Margin="0,0,4,0"
                      ToolTip="Drag to resize the card panel">
            <GridSplitter.Template>
                <ControlTemplate TargetType="GridSplitter">
                    <Border Background="Transparent">
                        <Border Width="4" Height="48" CornerRadius="2" Background="#60A0A0A0"
                                HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </GridSplitter.Template>
        </GridSplitter>

        <!-- ═══ MIDDLE: what you want ═══ -->
        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Margin="0,0,12,0">
            <StackPanel x:Name="ChoicesPanel">
                <TextBlock Text="Build a Deck" FontSize="20" FontWeight="SemiBold"/>
                <TextBlock Style="{StaticResource BoeHint}" TextWrapping="Wrap" Margin="0,2,0,6"
                           Text="Commander decks. The builder only uses what you allow below, and every card it picks says why."/>
                <Button x:Name="BtnIdeas" Content="What can I build?…" Padding="10,4" Margin="0,0,0,10" HorizontalAlignment="Left"
                        Click="BtnIdeas_Click" ToolTip="Your commanders, ranked by how much of a deck your free cards already make for them"/>

                <TextBlock Text="Commander" FontWeight="SemiBold"/>
                <ComboBox x:Name="CommanderBox" IsEditable="True" IsTextSearchEnabled="True" Margin="0,4,0,2"
                          ToolTip="Type to search. Cards you own are listed first."/>
                <TextBlock x:Name="CommanderInfo" Style="{StaticResource BoeHint}" TextWrapping="Wrap" Margin="0,0,0,10"/>

                <!-- A second commander: Partner, Partner with, Friends forever, Background, Doctor's companion -->
                <StackPanel x:Name="PartnerPanel" Visibility="Collapsed">
                    <TextBlock x:Name="PartnerLabel" Text="Second commander (optional)" FontWeight="SemiBold"/>
                    <DockPanel Margin="0,4,0,2">
                        <Button x:Name="BtnNoPartner" DockPanel.Dock="Right" Content="✕" Padding="8,4" Margin="4,0,0,0"
                                Click="BtnNoPartner_Click" ToolTip="No second commander"/>
                        <ComboBox x:Name="PartnerBox" IsEditable="True" IsTextSearchEnabled="True"
                                  ToolTip="Only cards that can be commanders together with the first are listed"/>
                    </DockPanel>
                    <TextBlock x:Name="PartnerInfo" Style="{StaticResource BoeHint}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                </StackPanel>

                <TextBlock Text="Bracket" FontWeight="SemiBold"/>
                <ComboBox x:Name="BracketBox" Margin="0,4,0,10" SelectedIndex="2">
                    <ComboBoxItem Content="1 — Exhibition"/>
                    <ComboBoxItem Content="2 — Core"/>
                    <ComboBoxItem Content="3 — Upgraded"/>
                    <ComboBoxItem Content="4 — Optimized"/>
                    <ComboBoxItem Content="5 — cEDH"/>
                </ComboBox>

                <TextBlock Text="Cards to use" FontWeight="SemiBold"/>
                <RadioButton x:Name="SourceCollection" Content="Only my collection's free copies" IsChecked="True" Margin="0,4,0,0"
                             GroupName="BuildSources" Checked="Sources_Changed"/>
                <RadioButton x:Name="SourcePool" Content="My collection + cards to get" Margin="0,2,0,0"
                             GroupName="BuildSources" Checked="Sources_Changed"/>
                <StackPanel x:Name="SpendPanel" Orientation="Horizontal" Margin="24,6,0,0" IsEnabled="False">
                    <TextBlock Text="Spend up to $" VerticalAlignment="Center"/>
                    <TextBox x:Name="SpendBox" Width="70" Text="0" Margin="4,0,0,0" TextAlignment="Right"
                             ToolTip="The most to spend on cards you don't own (they go on the Want List)"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,10">
                    <CheckBox x:Name="ValueCapCheck" Content="Deck worth at most $" VerticalAlignment="Center"
                              ToolTip="Optional: the most the whole deck may be worth (cards you own count too)"/>
                    <TextBox x:Name="ValueCapBox" Width="70" Text="100" Margin="4,0,0,0" TextAlignment="Right"
                             IsEnabled="{Binding IsChecked, ElementName=ValueCapCheck}"/>
                </StackPanel>

                <CheckBox x:Name="UseGuideCheck" Content="Use the guide" IsChecked="True" FontWeight="SemiBold"
                          ToolTip="About how many cards of each kind. Only a guide: change the numbers or switch any off. Off: just the best cards."/>
                <ItemsControl x:Name="GuideList" Margin="20,4,0,10"
                              IsEnabled="{Binding IsChecked, ElementName=UseGuideCheck}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="56"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0" IsChecked="{Binding Enabled, Mode=TwoWay}" Content="{Binding Label}"/>
                                <TextBox Grid.Column="1" Text="{Binding Count, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                         TextAlignment="Right" IsEnabled="{Binding Enabled}"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock x:Name="LocksText" Style="{StaticResource BoeHint}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                <Button x:Name="BtnClearLocks" Content="Clear locks and excludes" Padding="10,4" Margin="0,0,0,10"
                        HorizontalAlignment="Left" Click="BtnClearLocks_Click" Visibility="Collapsed"/>

                <StackPanel Orientation="Horizontal">
                    <Button x:Name="BtnBuild" Content="Build Draft" Padding="16,6" Margin="0,0,8,0"
                            Click="BtnBuild_Click" ToolTip="Build (or rebuild) the draft from the choices above"/>
                    <Button x:Name="BtnGuided" Content="Guided Build…" Padding="12,6"
                            Click="BtnGuided_Click" ToolTip="Build it step by step: pick the cards for each role yourself from the best options, then let the builder fill the rest"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- ═══ RIGHT: the draft ═══ -->
        <DockPanel Grid.Column="3">
            <Border DockPanel.Dock="Top" Background="{DynamicResource BoePanelBrush}" CornerRadius="8" Padding="12,8" Margin="0,0,0,8">
                <StackPanel>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button x:Name="BtnRule0" Content="Rule 0 Sheet…" Padding="10,4" Margin="0,0,8,0"
                                    Click="BtnRule0_Click" IsEnabled="False"
                                    ToolTip="What to tell the table before a game: bracket, Game Changers, combos, extra turns, tutors, how it wins"/>
                            <Button x:Name="BtnStats" Content="Statistics &amp; Test Hands…" Padding="10,4" Margin="0,0,8,0"
                                    Click="BtnStats_Click" IsEnabled="False"
                                    ToolTip="Deck Statistics for the draft: mana, combos, bracket, EDHREC, and Sample Hand to test draws"/>
                            <Button x:Name="BtnAccept" Content="Accept…" Padding="12,4" Click="BtnAccept_Click" IsEnabled="False"
                                    ToolTip="Save the draft as a new deck: your free copies claimed, the rest on the Want List for it"/>
                        </StackPanel>
                        <TextBlock x:Name="DraftHeadline" Text="No draft yet" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </DockPanel>
                    <!-- While building: what it's doing, with a moving bar -->
                    <DockPanel x:Name="BusyPanel" Margin="0,8,0,4" Visibility="Collapsed">
                        <Button x:Name="BtnCancel" DockPanel.Dock="Right" Content="Cancel" Padding="12,4" Margin="12,0,0,0"
                                VerticalAlignment="Center" Click="BtnCancel_Click" ToolTip="Stop the build (Esc). The last draft stays."/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="BusyText" FontSize="13" FontWeight="SemiBold"/>
                            <ProgressBar IsIndeterminate="True" Height="4" Margin="0,6,0,0"/>
                        </StackPanel>
                    </DockPanel>
                    <WrapPanel x:Name="RoleChips" Margin="0,6,0,0"/>
                    <TextBlock x:Name="DraftNotes" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <TextBlock x:Name="ActionText" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </Border>

            <DataGrid x:Name="DraftGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                      GridLinesVisibility="None" RowHeaderWidth="0" CanUserReorderColumns="True" SelectionMode="Extended"
                      SelectionChanged="DraftGrid_SelectionChanged">
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Lock (always keep it)" Click="Lock_Click"/>
                        <MenuItem Header="Exclude and rebuild" Click="Exclude_Click"/>
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Qty" Binding="{Binding Copies}" Width="45"/>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="220"/>
                    <DataGridTextColumn Header="Source" Binding="{Binding SourceText}" Width="110"/>
                    <!-- The full reason as a tooltip (the column may cut it off) -->
                    <DataGridTextColumn Header="Why" Binding="{Binding Reason}" Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="ToolTip" Value="{Binding Reason}"/>
                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="170"/>
                    <DataGridTextColumn Header="MV" Binding="{Binding ManaValue}" Width="45"/>
                    <DataGridTextColumn Header="Price" Binding="{Binding PriceText}" Width="70"/>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </Grid>
</Page>
