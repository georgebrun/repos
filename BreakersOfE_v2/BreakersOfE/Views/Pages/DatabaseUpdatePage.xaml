<Page x:Class="BreakersOfE.Views.Pages.DatabaseUpdatePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:vm="clr-namespace:BreakersOfE.ViewModels"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <!--
    ═══════════════════════════════════════════════════════════
    DATABASE UPDATE PAGE
    
    This page is bound to DatabaseUpdateViewModel.
    ALL logic is in the ViewModel — this XAML only displays.
    
    Think of it like an HMI screen:
      - TextBlocks are display tags
      - Buttons fire commands (like PLC subroutine calls)
      - The ProgressBar reads from a tag (ProgressPercent)
    ═══════════════════════════════════════════════════════════
    -->

    <Page.DataContext>
        <vm:DatabaseUpdateViewModel />
    </Page.DataContext>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16" MaxWidth="900" HorizontalAlignment="Left">

            <!-- ═══ HEADER ═══ -->
            <TextBlock Text="Update Database" Style="{StaticResource BoePageTitle}"/>
            <TextBlock Text="Download card data, prices and symbols from Scryfall."
                       Style="{StaticResource BoeHint}" Margin="0,0,0,12"/>

            <!-- ═══ LAST UPDATE INFO ═══ -->
            <Border Style="{StaticResource BoePanel}">
                <StackPanel>
                    <TextBlock Text="Last Updates" Style="{StaticResource BoeSectionTitle}"/>
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Card data:" Style="{StaticResource BoeLabel}"/>
                        <TextBlock Grid.Row="0" Grid.Column="2"
                                   Text="{Binding LastPoolUpdateText}" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Prices:" Style="{StaticResource BoeLabel}"
                                   Margin="0,4,0,0" />
                        <TextBlock Grid.Row="1" Grid.Column="2"
                                   Text="{Binding LastPriceUpdateText}"
                                   Margin="0,4,0,0" />
                    </Grid>

                    <!-- Staleness warning (amber: needs attention) -->
                    <TextBlock Text="{Binding PriceStaleWarning}"
                               Foreground="{DynamicResource BoeWarningBrush}"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0"
                               Visibility="{Binding PriceStaleWarning,
                                   Converter={StaticResource StringToVisibilityConverter}}" />
                </StackPanel>
            </Border>

            <!-- ═══ ACTION BUTTONS ═══ -->
            <Border Style="{StaticResource BoePanel}">
                <StackPanel>
                    <TextBlock Text="Update" Style="{StaticResource BoeSectionTitle}"/>
                    <TextBlock Style="{StaticResource BoeHint}" Margin="0,0,0,8"
                               Text="Update Database gets everything: card data, prices, symbols and rulings. The buttons below get one part on its own."/>
                    <!-- The start buttons are disabled while an update runs; Cancel sits
                         OUTSIDE that panel (a disabled panel disables everything in it). -->
                    <WrapPanel>
                        <WrapPanel IsEnabled="{Binding CanStart}">
                            <ui:Button Content="Update Database"
                                       Appearance="Primary"
                                       Command="{Binding StartFullUpdateWithRulingsCommand}"
                                       Margin="0,0,8,8"
                                       ToolTip="Card data, prices, symbols and rulings">
                                <ui:Button.Icon>
                                    <ui:SymbolIcon Symbol="ArrowDownload24" />
                                </ui:Button.Icon>
                            </ui:Button>
                            <ui:Button Content="Card Data Only"
                                       Command="{Binding StartFullUpdateCommand}"
                                       Margin="0,0,8,8"
                                       ToolTip="Card data, prices and symbols (no rulings)">
                                <ui:Button.Icon>
                                    <ui:SymbolIcon Symbol="ArrowDownload24" />
                                </ui:Button.Icon>
                            </ui:Button>
                            <ui:Button Content="Prices Only"
                                       Command="{Binding StartPriceUpdateCommand}"
                                       Margin="0,0,8,8">
                                <ui:Button.Icon>
                                    <ui:SymbolIcon Symbol="CurrencyDollarEuro24" />
                                </ui:Button.Icon>
                            </ui:Button>
                            <ui:Button Content="Rulings Only"
                                       Command="{Binding DownloadRulingsCommand}"
                                       Margin="0,0,8,8"
                                       ToolTip="All card rulings from Scryfall">
                                <ui:Button.Icon>
                                    <ui:SymbolIcon Symbol="BookOpen24" />
                                </ui:Button.Icon>
                            </ui:Button>
                        </WrapPanel>
                        <ui:Button Content="Cancel"
                                   Command="{Binding CancelCommand}"
                                   IsEnabled="{Binding CanCancel}"
                                   Margin="0,0,8,8">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="Dismiss24" />
                            </ui:Button.Icon>
                        </ui:Button>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- ═══ PROGRESS SECTION ═══ -->
            <Border Style="{StaticResource BoePanel}">
                <StackPanel>
                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource BoeSectionTitle}"
                               TextWrapping="Wrap"/>
                    <ProgressBar Value="{Binding ProgressPercent}"
                                 Minimum="0" Maximum="100"
                                 Height="8"
                                 Margin="0,4,0,8" />
                    <TextBlock Text="{Binding DetailText}" Style="{StaticResource BoeHint}"/>
                </StackPanel>
            </Border>

            <!-- ═══ SCHEMA WARNING ═══ -->
            <Border Style="{StaticResource BoePanel}"
                    Visibility="{Binding HasSchemaWarning,
                        Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <ui:SymbolIcon Symbol="Warning24" Foreground="{DynamicResource BoeWarningBrush}"
                                       Margin="0,0,8,0" />
                        <TextBlock Text="Scryfall Schema Warning" Style="{StaticResource BoeSectionTitle}"
                                   Foreground="{DynamicResource BoeWarningBrush}" Margin="0"/>
                    </StackPanel>
                    <TextBlock Text="{Binding SchemaWarning}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>

</Page>
