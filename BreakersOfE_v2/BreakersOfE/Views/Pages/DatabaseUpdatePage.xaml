<Page x:Class="BreakersOfE.Views.Pages.DatabaseUpdatePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:vm="clr-namespace:BreakersOfE.ViewModels">

    <!--
    ═══════════════════════════════════════════════════════════
    DATABASE UPDATE PAGE
    
    This page is bound to DatabaseUpdateViewModel.
    ALL logic is in the ViewModel — this XAML only displays.
    
    Think of it like an HMI screen:
      - TextBlocks are display tags
      - Buttons fire commands (like PLC subroutine calls)
      - The ProgressBar reads from a tag (ProgressPercent)
    ═══════════════════════════════════════════════════════════
    -->

    <Page.DataContext>
        <vm:DatabaseUpdateViewModel />
    </Page.DataContext>

    <ScrollViewer Margin="24">
        <StackPanel MaxWidth="700" HorizontalAlignment="Left">

            <!-- ═══ HEADER ═══ -->
            <TextBlock Text="Database Update"
                       FontSize="32" FontWeight="SemiBold"
                       Margin="0,0,0,8" />
            <TextBlock Text="Download card data, prices, and symbols from Scryfall."
                       FontSize="14" Opacity="0.6"
                       Margin="0,0,0,24" />

            <!-- ═══ LAST UPDATE INFO ═══ -->
            <ui:Card Margin="0,0,0,16">
                <StackPanel Margin="16">
                    <TextBlock Text="Last Updates" FontSize="16" FontWeight="Medium"
                               Margin="0,0,0,12" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Full Update:"
                                   Opacity="0.6" />
                        <TextBlock Grid.Row="0" Grid.Column="2"
                                   Text="{Binding LastPoolUpdateText}" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Prices:"
                                   Opacity="0.6" Margin="0,4,0,0" />
                        <TextBlock Grid.Row="1" Grid.Column="2"
                                   Text="{Binding LastPriceUpdateText}"
                                   Margin="0,4,0,0" />
                    </Grid>

                    <!-- Staleness warning -->
                    <TextBlock Text="{Binding PriceStaleWarning}"
                               Foreground="Orange"
                               Margin="0,8,0,0"
                               Visibility="{Binding PriceStaleWarning, 
                                   Converter={StaticResource StringToVisibilityConverter}}" />
                </StackPanel>
            </ui:Card>

            <!-- ═══ ACTION BUTTONS ═══ -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,24"
                        IsEnabled="{Binding CanStart}">

                <ui:Button Content="Full Database Update"
                           Appearance="Primary"
                           Command="{Binding StartFullUpdateCommand}"
                           Margin="0,0,12,0">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="ArrowDownload24" />
                    </ui:Button.Icon>
                </ui:Button>

                <ui:Button Content="Update Prices Only"
                           Command="{Binding StartPriceUpdateCommand}"
                           Margin="0,0,12,0">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="CurrencyDollarEuro24" />
                    </ui:Button.Icon>
                </ui:Button>

                <ui:Button Content="Cancel"
                           Command="{Binding CancelCommand}"
                           IsEnabled="{Binding IsRunning}"
                           Appearance="Danger">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="Dismiss24" />
                    </ui:Button.Icon>
                </ui:Button>
            </StackPanel>

            <!-- ═══ PROGRESS SECTION ═══ -->
            <ui:Card Margin="0,0,0,16">
                <StackPanel Margin="16">

                    <!-- Status text -->
                    <TextBlock Text="{Binding StatusText}"
                               FontSize="16" FontWeight="Medium"
                               Margin="0,0,0,8" />

                    <!-- Progress bar -->
                    <ProgressBar Value="{Binding ProgressPercent}"
                                 Minimum="0" Maximum="100"
                                 Height="8"
                                 Margin="0,0,0,8" />

                    <!-- Detail text (card counts, etc.) -->
                    <TextBlock Text="{Binding DetailText}"
                               FontSize="12" Opacity="0.6"
                               TextWrapping="Wrap" />

                </StackPanel>
            </ui:Card>

            <!-- ═══ SCHEMA WARNING ═══ -->
            <ui:Card Margin="0,0,0,16"
                     Visibility="{Binding HasSchemaWarning, 
                         Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel Margin="16">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <ui:SymbolIcon Symbol="Warning24" Foreground="Orange"
                                       Margin="0,0,8,0" />
                        <TextBlock Text="Scryfall Schema Warning"
                                   FontSize="16" FontWeight="Medium"
                                   Foreground="Orange" />
                    </StackPanel>
                    <TextBlock Text="{Binding SchemaWarning}"
                               TextWrapping="Wrap"
                               Opacity="0.8" />
                </StackPanel>
            </ui:Card>

        </StackPanel>
    </ScrollViewer>

</Page>
