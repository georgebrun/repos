<Page x:Class="BreakersOfE.Views.Pages.EditWantListPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ctl="clr-namespace:BreakersOfE.Views.Controls"
      ScrollViewer.VerticalScrollBarVisibility="Disabled"
      Loaded="Page_Loaded"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <!-- Edit → Lists → Pool → Want List: the card pool on top, the Want List
         below (same tables as View, embedded), the card detail panel on the
         left for whichever card was selected last. -->
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="DetailColumn" Width="240" MinWidth="180" MaxWidth="480"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*" MinWidth="300"/>
        </Grid.ColumnDefinitions>

        <!-- ═══ LEFT DETAIL PANEL (last card selected in either table) ═══ -->
        <ctl:CardDetailPanel x:Name="Detail" Grid.Column="0" Margin="0,0,4,0"/>

        <!-- Drag to widen or narrow the card panel -->
        <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                      DragCompleted="DetailSplitter_DragCompleted"
                      Background="Transparent" Cursor="SizeWE" Margin="0,0,4,0"
                      ToolTip="Drag to resize the card panel">
            <GridSplitter.Template>
                <ControlTemplate TargetType="GridSplitter">
                    <Border Background="Transparent">
                        <Border Width="4" Height="48" CornerRadius="2" Background="#60A0A0A0"
                                HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </GridSplitter.Template>
        </GridSplitter>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="TopRow" Height="*" MinHeight="140"/>
                <!-- pool -->
                <RowDefinition Height="Auto"/>
                <!-- splitter -->
                <RowDefinition x:Name="BottomRow" Height="*" MinHeight="200"/>
                <!-- buttons + want list -->
            </Grid.RowDefinitions>

            <!-- ═══ TOP: card pool ═══ -->
            <Frame Grid.Row="0" x:Name="TopFrame" NavigationUIVisibility="Hidden"
                   JournalOwnership="OwnsJournal" Focusable="False"/>

            <!-- Drag to share the height between the two tables (remembered) -->
            <GridSplitter Grid.Row="1" x:Name="TableSplitter" Height="12" HorizontalAlignment="Stretch"
                          ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                          Background="Transparent" Cursor="SizeNS" Margin="0,2,0,2"
                          DragCompleted="TableSplitter_DragCompleted"
                          ToolTip="Drag to resize the tables">
                <GridSplitter.Template>
                    <ControlTemplate TargetType="GridSplitter">
                        <Border Background="Transparent">
                            <Border Height="4" Width="80" CornerRadius="2" Background="#60A0A0A0"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </GridSplitter.Template>
            </GridSplitter>

            <DockPanel Grid.Row="2">
                <!-- ═══ BUTTONS (Pool → Want List) ═══
                 Act on the rows selected last, in either table. Qty applies to
                 every button (and the keys / right-click). -->
                <Border DockPanel.Dock="Top" Background="{DynamicResource BoePanelBrush}" CornerRadius="8"
                    Padding="12,8" Margin="0,0,0,8">
                    <StackPanel>
                        <WrapPanel VerticalAlignment="Center">
                            <TextBlock Text="Qty" VerticalAlignment="Center" Margin="0,0,6,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <TextBox x:Name="QtyBox" Text="1" Width="56" Margin="0,0,14,0"
                                 VerticalAlignment="Center" TextAlignment="Center"
                                 PreviewTextInput="QtyBox_PreviewTextInput"
                                 PreviewKeyDown="QtyBox_PreviewKeyDown"
                                 GotKeyboardFocus="QtyBox_GotKeyboardFocus"
                                 ToolTip="How many copies each button adds, removes or moves (Ctrl+Q). Enter adds the default finish."/>

                            <Button x:Name="BtnAddNonFoil" Content="Add Non-Foil" Padding="10,4" Margin="0,0,6,0"
                                Click="BtnAddNonFoil_Click" ToolTip="Put Qty non-foil copies on the Want List (Enter)"/>
                            <Button x:Name="BtnAddFoil" Content="Add Foil" Padding="10,4" Margin="0,0,6,0"
                                Click="BtnAddFoil_Click" ToolTip="Put Qty foil copies on the Want List (Shift+Enter)"/>
                            <Button x:Name="BtnAddEtched" Content="Add Etched" Padding="10,4" Margin="0,0,6,0"
                                Click="BtnAddEtched_Click" ToolTip="Put Qty etched copies on the Want List (Ctrl+Enter)"/>
                            <Button x:Name="BtnRemove" Content="Remove" Padding="10,4" Margin="0,0,18,0"
                                Click="BtnRemove_Click" ToolTip="Take Qty copies off the Want List (Delete)"/>

                            <Button x:Name="BtnGotIt" Content="Got It…" Padding="10,4" Margin="0,0,6,0"
                                Click="BtnGotIt_Click"
                                ToolTip="You got Qty copies: they go into your collection (with the language and condition picked here) and come off the Want List"/>
                            <TextBlock Text="as" VerticalAlignment="Center" Margin="0,0,6,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <ComboBox x:Name="LanguageBox" SelectionChanged="Defaults_SelectionChanged" Width="170" Margin="0,0,6,0" VerticalAlignment="Center"
                                  ToolTip="Language of the copies you got"/>
                            <ComboBox x:Name="ConditionBox" SelectionChanged="Defaults_SelectionChanged" Width="180" Margin="0,0,18,0" VerticalAlignment="Center"
                                  ToolTip="Condition of the copies you got"/>

                            <Button x:Name="BtnUndo" Content="Undo" Padding="10,4"
                                Click="BtnUndo_Click" ToolTip="Nothing to undo (Ctrl+Z)"/>
                        </WrapPanel>
                        <!-- The card the buttons act on -->
                        <TextBlock x:Name="ModeText" Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <!-- What the last action did (amber when something was refused) -->
                        <TextBlock x:Name="ActionText" Margin="0,2,0,0" FontSize="12" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </Border>

                <!-- ═══ BOTTOM: Want List ═══ -->
                <Frame x:Name="BottomFrame" NavigationUIVisibility="Hidden"
                   JournalOwnership="OwnsJournal" Focusable="False"/>
            </DockPanel>
        </Grid>
    </Grid>
</Page>
