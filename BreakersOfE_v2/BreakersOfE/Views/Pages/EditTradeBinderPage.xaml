<Page x:Class="BreakersOfE.Views.Pages.EditTradeBinderPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ctl="clr-namespace:BreakersOfE.Views.Controls"
      ScrollViewer.VerticalScrollBarVisibility="Disabled"
      Loaded="Page_Loaded"
      Unloaded="Page_Unloaded"
      PreviewKeyDown="Page_PreviewKeyDown">

    <!-- Edit → Lists → Collection → Trade Binder: your card collection on top,
         the Trade Binder below (same tables as View, embedded), the card
         detail panel on the left for whichever card was selected last. -->
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="DetailColumn" Width="240" MinWidth="180" MaxWidth="480"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*" MinWidth="300"/>
        </Grid.ColumnDefinitions>

        <!-- ═══ LEFT DETAIL PANEL (last card selected in either table) ═══ -->
        <ctl:CardDetailPanel x:Name="Detail" Grid.Column="0" Margin="0,0,4,0"/>

        <!-- Drag to widen or narrow the card panel -->
        <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                      DragCompleted="DetailSplitter_DragCompleted"
                      Background="Transparent" Cursor="SizeWE" Margin="0,0,4,0"
                      ToolTip="Drag to resize the card panel">
            <GridSplitter.Template>
                <ControlTemplate TargetType="GridSplitter">
                    <Border Background="Transparent">
                        <Border Width="4" Height="48" CornerRadius="2" Background="#60A0A0A0"
                                HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </GridSplitter.Template>
        </GridSplitter>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="TopRow" Height="*" MinHeight="140"/>   <!-- collection -->
                <RowDefinition Height="Auto"/>                                <!-- splitter -->
                <RowDefinition x:Name="BottomRow" Height="*" MinHeight="200"/> <!-- buttons + binder -->
            </Grid.RowDefinitions>

            <!-- ═══ TOP: card collection ═══ -->
            <Frame Grid.Row="0" x:Name="TopFrame" NavigationUIVisibility="Hidden"
                   JournalOwnership="OwnsJournal" Focusable="False"/>

            <!-- Drag to share the height between the two tables (remembered) -->
            <GridSplitter Grid.Row="1" x:Name="TableSplitter" Height="12" HorizontalAlignment="Stretch"
                          ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                          Background="Transparent" Cursor="SizeNS" Margin="0,2,0,2"
                          DragCompleted="TableSplitter_DragCompleted"
                          ToolTip="Drag to resize the tables">
                <GridSplitter.Template>
                    <ControlTemplate TargetType="GridSplitter">
                        <Border Background="Transparent">
                            <Border Height="4" Width="80" CornerRadius="2" Background="#60A0A0A0"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </GridSplitter.Template>
            </GridSplitter>

            <DockPanel Grid.Row="2">
            <!-- ═══ BUTTONS (Collection → Trade Binder) ═══
                 Act on the rows selected last, in either table. Qty applies to
                 every button (and the keys / right-click). -->
            <Border DockPanel.Dock="Top" Background="#15808080" CornerRadius="8"
                    Padding="12,6" Margin="0,0,0,8">
                <StackPanel>
                    <WrapPanel VerticalAlignment="Center">
                        <TextBlock Text="Qty" VerticalAlignment="Center" Margin="0,0,6,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <TextBox x:Name="QtyBox" Text="1" Width="56" Margin="0,0,14,0"
                                 VerticalAlignment="Center" TextAlignment="Center"
                                 PreviewTextInput="QtyBox_PreviewTextInput"
                                 PreviewKeyDown="QtyBox_PreviewKeyDown"
                                 GotKeyboardFocus="QtyBox_GotKeyboardFocus"
                                 ToolTip="How many copies each button moves (Ctrl+Q). Enter puts them in the binder."/>

                        <Button x:Name="BtnAdd" Content="Add to Binder" Padding="10,4" Margin="0,0,6,0"
                                Click="BtnAdd_Click"
                                ToolTip="Put Qty free copies of the selected collection rows in the Trade Binder (Enter). They count as Used, so no deck can take them."/>
                        <Button x:Name="BtnRemove" Content="Remove from Binder" Padding="10,4" Margin="0,0,18,0"
                                Click="BtnRemove_Click"
                                ToolTip="Take Qty copies out of the Trade Binder — back to Available in your collection (Delete)"/>

                        <Button x:Name="BtnTraded" Content="Traded / Sold" Padding="10,4" Margin="0,0,18,0"
                                Click="BtnTraded_Click"
                                ToolTip="Qty copies are gone: out of the Trade Binder AND your collection (asks first)"/>

                        <Button x:Name="BtnUndo" Content="Undo" Padding="10,4" Margin="0,0,18,0"
                                Click="BtnUndo_Click" ToolTip="Nothing to undo (Ctrl+Z)"/>

                        <TextBlock x:Name="TradePercentText" VerticalAlignment="Center" FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   ToolTip="Card shops usually pay a share of the market price in trade credit. Trade Value = market price × Trade %. Trade % is a setting."/>
                    </WrapPanel>
                    <!-- The card the buttons act on -->
                    <TextBlock x:Name="ModeText" Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <!-- What the last action did (amber when something was refused) -->
                    <TextBlock x:Name="ActionText" Margin="0,2,0,0" FontSize="12" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </Border>

            <!-- ═══ BOTTOM: Trade Binder ═══ -->
            <Frame x:Name="BottomFrame" NavigationUIVisibility="Hidden"
                   JournalOwnership="OwnsJournal" Focusable="False"/>
            </DockPanel>
        </Grid>
    </Grid>
</Page>
