<Page x:Class="BreakersOfE.Views.Pages.PoolPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:svc="clr-namespace:BreakersOfE.Services"
      xmlns:vm="clr-namespace:BreakersOfE.ViewModels"
      xmlns:ctl="clr-namespace:BreakersOfE.Views.Controls"
      ScrollViewer.VerticalScrollBarVisibility="Disabled">

    <Page.DataContext>
        <vm:PoolViewModel />
    </Page.DataContext>

    <Page.Resources>
        <svc:BoolToGreenRedConverter x:Key="BoolToGreenRedConverter" />
        <svc:ImageSourceConverter x:Key="ImageSourceConverter" />
        <svc:ManaCostConverter x:Key="ManaCostConverter" />

        <!-- Detail panel label/value styles -->

        <!-- ═══════════════════════════════════════════════════════════════
             Column header with a funnel button. Every filterable column uses
             this template. The funnel's Tag carries the column name so the
             code-behind knows which column to open the filter popup for.
             The funnel glyph turns accented when a filter is active (bound by
             the code-behind toggling Tag on the TextBlock).
             ═══════════════════════════════════════════════════════════════ -->
        <DataTemplate x:Key="FilterableHeader">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>

                <Button Grid.Column="1" x:Name="FunnelButton"
                        Tag="{Binding}"
                        Width="18" Height="18" Padding="0"
                        Margin="4,0,0,0"
                        Background="Transparent" BorderThickness="0"
                        Cursor="Hand"
                        Click="Funnel_Click">
                    <TextBlock x:Name="FunnelIcon"
                               Text="&#xE71C;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="11"
                               Foreground="#9F9F9F"/>
                </Button>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" MinWidth="180" MaxWidth="320"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ═══ LEFT DETAIL PANEL ═══ -->
        <ctl:CardDetailPanel x:Name="Detail" Grid.Column="0" Margin="0,0,12,0"
                             ImageDoubleClicked="Detail_ImageDoubleClicked"/>

        <!-- ═══ RIGHT CONTENT (header + grid + status) ═══ -->
        <Grid Grid.Column="1">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══ HEADER ═══ -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="{Binding Title}"
                       FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Margin="0,0,12,0">
                <Button x:Name="BtnBackToSets" Content="◀  All Sets"
                        Padding="10,4" Margin="0,0,8,0"
                        Visibility="Collapsed"
                        Click="BtnBackToSets_Click"
                        ToolTip="Back to the set browser"/>
                <Button x:Name="BtnEditionOrder" Content="Edition: Chrono"
                        Padding="10,4" Margin="0,0,8,0"
                        Click="BtnEditionOrder_Click"
                        ToolTip="Toggle edition sub-sort: Alphabetical ↔ Chronological"/>
                <Button x:Name="BtnClearFilters" Content="Clear All Filters" Padding="10,4"
                        Click="ClearAllFilters_Click"/>
            </StackPanel>

            <!-- Search — begins-with, scroll-to, NEVER filters rows -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Search:" VerticalAlignment="Center" Margin="0,0,6,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                <TextBox x:Name="SearchBox" Width="240" VerticalAlignment="Center"
                         TextChanged="SearchBox_TextChanged"/>
            </StackPanel>
        </Grid>

        <!-- ═══ POOL GRID (plain WPF DataGrid + funnel headers) ═══ -->
        <DataGrid Grid.Row="1" x:Name="PoolGrid"
                  ItemsSource="{Binding Items}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  HeadersVisibility="Column"
                  GridLinesVisibility="None"
                  RowHeaderWidth="0"
                  RowHeight="26"
                  CanUserResizeColumns="True"
                  CanUserReorderColumns="True"
                  CanUserSortColumns="True"
                  EnableRowVirtualization="True"
                  EnableColumnVirtualization="True"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  ScrollViewer.CanContentScroll="True"
                  RowDetailsVisibilityMode="Collapsed"
                  MouseDoubleClick="PoolGrid_MouseDoubleClick">

            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="Foreground" Value="{Binding RowForegroundBrush}" />
                    <Setter Property="Background" Value="{Binding RowBackgroundBrush}" />
                    <Style.Triggers>
                        <!-- The Background setter above hides the default selection
                             color, so draw selection explicitly. Light blue keeps the
                             color-identity text readable; the blue edge marks the row
                             whether or not the grid has focus. -->
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#C8E1FF" />
                            <Setter Property="BorderBrush" Value="#4CA0FF" />
                            <Setter Property="BorderThickness" Value="0,1,0,1" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>

            <DataGrid.Columns>

                <!-- Set symbol (no filter, no funnel) -->
                <DataGridTemplateColumn Header="Set" Width="40" CanUserResize="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Image Width="18" Height="18"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   RenderOptions.BitmapScalingMode="HighQuality">
                                <Image.Source>
                                    <MultiBinding Converter="{StaticResource ImageSourceConverter}">
                                        <Binding Path="SetSymbolPath" />
                                        <Binding Path="Rarity" />
                                    </MultiBinding>
                                </Image.Source>
                            </Image>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Name"         Binding="{Binding Name}"            Width="210"
                                    HeaderTemplate="{StaticResource FilterableHeader}" />
                <DataGridTextColumn Header="Edition"      Binding="{Binding SetCode}"         Width="60"
                                    HeaderTemplate="{StaticResource FilterableHeader}" />
                <DataGridTextColumn Header="Edition Name" Binding="{Binding SetName}"         Width="170"
                                    HeaderTemplate="{StaticResource FilterableHeader}" />
                <DataGridTextColumn Header="Type"         Binding="{Binding TypeLine}"        Width="190"
                                    HeaderTemplate="{StaticResource FilterableHeader}" />
                <DataGridTextColumn Header="Rarity"       Binding="{Binding RarityCode}"      Width="55"
                                    HeaderTemplate="{StaticResource FilterableHeader}" />

                <!-- Mana cost (no filter) -->
                <DataGridTemplateColumn Header="Cost" Width="110">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ContentPresenter Content="{Binding ManaCost,
                                              Converter={StaticResource ManaCostConverter}}"
                                              VerticalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="P/T"     Binding="{Binding PowerToughness}"      Width="55"
                                    HeaderTemplate="{StaticResource FilterableHeader}" />
                <DataGridTextColumn Header="USD"     Binding="{Binding PriceUsdDisplay}"     Width="70"
                                    HeaderTemplate="{StaticResource FilterableHeader}" />
                <DataGridTextColumn Header="Foil $"  Binding="{Binding PriceUsdFoilDisplay}" Width="70"
                                    HeaderTemplate="{StaticResource FilterableHeader}" />
                <DataGridTextColumn Header="Text"    Binding="{Binding OracleText}"          Width="260"
                                    HeaderTemplate="{StaticResource FilterableHeader}" />
                <DataGridTextColumn Header="Artist"  Binding="{Binding Artist}"              Width="140"
                                    HeaderTemplate="{StaticResource FilterableHeader}" />
                <DataGridTextColumn Header="No."     Binding="{Binding CollectorNumber}"     Width="55"
                                    HeaderTemplate="{StaticResource FilterableHeader}" />

            </DataGrid.Columns>
        </DataGrid>

        <!-- ═══ CARD GALLERY — its own view (Views/Controls/GalleryView) ═══ -->
        <ctl:GalleryView Grid.Row="1" x:Name="Gallery" Visibility="Collapsed"/>

        <!-- ═══ SET BROWSER (virtualized: section headers + rows of set tiles) ═══
             Built from the in-memory pool. Click a tile → Edition filter
             for that set + gallery view. -->
        <ListBox Grid.Row="1" x:Name="SetList"
                 Visibility="Collapsed"
                 Background="Transparent" BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.CanContentScroll="True"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling"
                 VirtualizingPanel.ScrollUnit="Pixel"
                 SizeChanged="SetList_SizeChanged">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Focusable" Value="False"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <ContentPresenter/>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <!-- Section header -->
                        <Border Visibility="{Binding IsHeader, Converter={StaticResource BoolToVisibilityConverter}}"
                                Margin="4,18,12,8" Padding="0,0,0,6"
                                BorderBrush="#40808080" BorderThickness="0,0,0,1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding HeaderText}" FontSize="16" FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                <Border Margin="10,0,0,0" CornerRadius="9" Padding="8,1"
                                        Background="#40808080" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding HeaderCount}" FontSize="12"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Row of set tiles -->
                        <ItemsControl ItemsSource="{Binding Tiles}"
                                      Visibility="{Binding IsTileRow, Converter={StaticResource BoolToVisibilityConverter}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="300" Height="72" Margin="4" CornerRadius="8"
                                            BorderThickness="2" Cursor="Hand"
                                            ToolTip="{Binding Name}"
                                            MouseLeftButtonDown="SetTile_MouseLeftButtonDown">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#18808080"/>
                                                <Setter Property="BorderBrush" Value="Transparent"/>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#30808080"/>
                                                    </Trigger>
                                                    <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                                                        <Setter Property="BorderBrush" Value="#4CA0FF"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="64"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Image Grid.Column="0" Source="{Binding Symbol}"
                                                   Width="34" Height="34"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center"
                                                        Margin="0,0,10,0">
                                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                <TextBlock Text="{Binding Summary}" FontSize="12" Margin="0,3,0,0"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>


        <!-- Empty-state -->
        <Border Grid.Row="1" Background="#20000000" CornerRadius="8"
                Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock Text="{Binding EmptyMessage}" TextAlignment="Center" TextWrapping="Wrap"
                       MaxWidth="420" Opacity="0.8"
                       VerticalAlignment="Center" HorizontalAlignment="Center"/>
        </Border>

        <!-- Loading overlay -->
        <Border Grid.Row="1" Background="#40000000"
                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ui:ProgressRing IsIndeterminate="True" Width="48" Height="48"/>
                <TextBlock Text="Loading pool..." Margin="0,12,0,0" HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
        </Border>

        <!-- ═══ STATUS BAR ═══ -->
        <DockPanel Grid.Row="2" Margin="0,6,0,0" LastChildFill="True">
            <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center"
                       FontSize="13" Opacity="0.7"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
        </DockPanel>
        </Grid> <!-- end right content grid -->
    </Grid>
</Page>
