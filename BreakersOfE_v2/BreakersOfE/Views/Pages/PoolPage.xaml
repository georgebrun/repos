<Page x:Class="BreakersOfE.Views.Pages.PoolPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:svc="clr-namespace:BreakersOfE.Services"
      xmlns:vm="clr-namespace:BreakersOfE.ViewModels"
      ScrollViewer.VerticalScrollBarVisibility="Disabled">

    <Page.DataContext>
        <vm:PoolViewModel />
    </Page.DataContext>

    <Page.Resources>
        <svc:BoolToGreenRedConverter x:Key="BoolToGreenRedConverter" />
        <svc:ImageSourceConverter x:Key="ImageSourceConverter" />
        <svc:ManaCostConverter x:Key="ManaCostConverter" />

        <!-- Detail panel label/value styles -->
        <Style x:Key="DetailLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
            <Setter Property="Margin" Value="0,6,0,1"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
        </Style>
        <Style x:Key="DetailValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- ═══════════════════════════════════════════════════════════════
             Column header with a funnel button. Every filterable column uses
             this template. The funnel's Tag carries the column name so the
             code-behind knows which column to open the filter popup for.
             The funnel glyph turns accented when a filter is active (bound by
             the code-behind toggling Tag on the TextBlock).
             ═══════════════════════════════════════════════════════════════ -->
        <DataTemplate x:Key="FilterableHeader">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>

                <Button Grid.Column="1" x:Name="FunnelButton"
                        Tag="{Binding}"
                        Width="18" Height="18" Padding="0"
                        Margin="4,0,0,0"
                        Background="Transparent" BorderThickness="0"
                        Cursor="Hand"
                        Click="Funnel_Click">
                    <TextBlock x:Name="FunnelIcon"
                               Text="&#xE71C;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="11"
                               Foreground="#9F9F9F"/>
                </Button>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" MinWidth="180" MaxWidth="320"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ═══ LEFT DETAIL PANEL ═══ -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto"
                      Margin="0,0,12,0">
            <StackPanel x:Name="DetailPanel">

                <!-- Card image -->
                <Border CornerRadius="8" Background="#20808080"
                        HorizontalAlignment="Center" Margin="0,0,0,8"
                        MaxWidth="220">
                    <Image x:Name="DetailCardImage" Stretch="Uniform"
                           MaxHeight="310"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           MouseLeftButtonDown="DetailImage_MouseDoubleClick"
                           Cursor="Hand"/>
                </Border>

                <!-- Show Back Face button (hidden by default) -->
                <Button x:Name="BtnShowBackFace" Content="🔄 Show Back Face"
                        HorizontalAlignment="Center" Margin="0,0,0,8"
                        Padding="8,4" FontSize="11"
                        Visibility="Collapsed"
                        Click="BtnShowBackFace_Click"/>

                <!-- Detail fields -->
                <TextBlock Text="NAME" Style="{StaticResource DetailLabel}"/>
                <TextBlock x:Name="DetailName" Style="{StaticResource DetailValue}"
                           FontSize="15" FontWeight="Bold"/>

                <TextBlock Text="MANA COST" Style="{StaticResource DetailLabel}"/>
                <ItemsControl x:Name="DetailManaCost" Margin="0,0,0,6">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <TextBlock Text="TYPE" Style="{StaticResource DetailLabel}"/>
                <TextBlock x:Name="DetailType" Style="{StaticResource DetailValue}"/>

                <TextBlock Text="SET" Style="{StaticResource DetailLabel}"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <Image x:Name="DetailSetSymbol" Width="16" Height="16"
                           Margin="0,0,5,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="DetailSet" Style="{StaticResource DetailValue}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock Text="COLLECTOR NUMBER" Style="{StaticResource DetailLabel}"/>
                <TextBlock x:Name="DetailCollectorNumber" Style="{StaticResource DetailValue}"/>

                <TextBlock Text="RARITY" Style="{StaticResource DetailLabel}"/>
                <TextBlock x:Name="DetailRarity" Style="{StaticResource DetailValue}"/>

                <TextBlock x:Name="DetailPTLabel" Text="POWER / TOUGHNESS"
                           Style="{StaticResource DetailLabel}"/>
                <TextBlock x:Name="DetailPT" Style="{StaticResource DetailValue}"/>

                <TextBlock Text="ORACLE TEXT" Style="{StaticResource DetailLabel}"/>
                <TextBlock x:Name="DetailOracle" Style="{StaticResource DetailValue}"
                           FontSize="12" TextWrapping="Wrap"/>

                <TextBlock Text="FLAVOR TEXT" Style="{StaticResource DetailLabel}"/>
                <TextBlock x:Name="DetailFlavor" Style="{StaticResource DetailValue}"
                           FontSize="12" FontStyle="Italic" Opacity="0.7"
                           TextWrapping="Wrap"/>

                <TextBlock Text="ARTIST" Style="{StaticResource DetailLabel}"/>
                <TextBlock x:Name="DetailArtist" Style="{StaticResource DetailValue}"/>

                <TextBlock Text="AVAILABLE AS" Style="{StaticResource DetailLabel}"/>
                <TextBlock x:Name="DetailFinishes" Style="{StaticResource DetailValue}"/>

                <TextBlock Text="PRICES (USD)" Style="{StaticResource DetailLabel}"/>
                <TextBlock x:Name="DetailPrices" Style="{StaticResource DetailValue}"
                           FontSize="12"/>

            </StackPanel>
        </ScrollViewer>

        <!-- ═══ RIGHT CONTENT (header + grid + status) ═══ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ═══ HEADER ═══ -->
            <Grid Grid.Row="0" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding Title}"
                       FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Margin="0,0,12,0">
                    <Button Content="Edition: A→Z" Padding="10,4" Margin="0,0,8,0"
                        Click="BtnEditionOrder_Click"
                        ToolTip="Toggle edition sub-sort: Alphabetical ↔ Chronological"/>
                    <Button Content="Clear All Filters" Padding="10,4"
                        Click="ClearAllFilters_Click"/>
                </StackPanel>

                <!-- Search — begins-with, scroll-to, NEVER filters rows -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Search:" VerticalAlignment="Center" Margin="0,0,6,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <TextBox x:Name="SearchBox" Width="240" VerticalAlignment="Center"
                         TextChanged="SearchBox_TextChanged"/>
                </StackPanel>
            </Grid>

            <!-- ═══ POOL GRID (plain WPF DataGrid + funnel headers) ═══ -->
            <DataGrid Grid.Row="1" x:Name="PoolGrid"
                  ItemsSource="{Binding Items}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  HeadersVisibility="Column"
                  GridLinesVisibility="None"
                  RowHeaderWidth="0"
                  RowHeight="26"
                  CanUserResizeColumns="True"
                  CanUserReorderColumns="True"
                  CanUserSortColumns="True"
                  EnableRowVirtualization="True"
                  EnableColumnVirtualization="True"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  ScrollViewer.CanContentScroll="True"
                  RowDetailsVisibilityMode="Collapsed"
                  MouseDoubleClick="PoolGrid_MouseDoubleClick">

                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Foreground" Value="{Binding RowForegroundBrush}" />
                        <Setter Property="Background" Value="{Binding RowBackgroundBrush}" />
                    </Style>
                </DataGrid.RowStyle>

                <DataGrid.Columns>

                    <!-- Set symbol (no filter, no funnel) -->
                    <DataGridTemplateColumn Header="Set" Width="40" CanUserResize="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Image Width="18" Height="18"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   RenderOptions.BitmapScalingMode="HighQuality">
                                    <Image.Source>
                                        <MultiBinding Converter="{StaticResource ImageSourceConverter}">
                                            <Binding Path="SetSymbolPath" />
                                            <Binding Path="Rarity" />
                                        </MultiBinding>
                                    </Image.Source>
                                </Image>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Name"         Binding="{Binding Name}"            Width="210"
                                    HeaderTemplate="{StaticResource FilterableHeader}" />
                    <DataGridTextColumn Header="Edition"      Binding="{Binding SetCode}"         Width="60"
                                    HeaderTemplate="{StaticResource FilterableHeader}" />
                    <DataGridTextColumn Header="Edition Name" Binding="{Binding SetName}"         Width="170"
                                    HeaderTemplate="{StaticResource FilterableHeader}" />
                    <DataGridTextColumn Header="Type"         Binding="{Binding TypeLine}"        Width="190"
                                    HeaderTemplate="{StaticResource FilterableHeader}" />
                    <DataGridTextColumn Header="Rarity"       Binding="{Binding RarityCode}"      Width="55"
                                    HeaderTemplate="{StaticResource FilterableHeader}" />

                    <!-- Mana cost (no filter) -->
                    <DataGridTemplateColumn Header="Cost" Width="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ContentPresenter Content="{Binding ManaCost,
                                              Converter={StaticResource ManaCostConverter}}"
                                              VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="P/T"     Binding="{Binding PowerToughness}"      Width="55"
                                    HeaderTemplate="{StaticResource FilterableHeader}" />
                    <DataGridTextColumn Header="USD"     Binding="{Binding PriceUsdDisplay}"     Width="70"
                                    HeaderTemplate="{StaticResource FilterableHeader}" />
                    <DataGridTextColumn Header="Foil $"  Binding="{Binding PriceUsdFoilDisplay}" Width="70"
                                    HeaderTemplate="{StaticResource FilterableHeader}" />
                    <DataGridTextColumn Header="Text"    Binding="{Binding OracleText}"          Width="260"
                                    HeaderTemplate="{StaticResource FilterableHeader}" />
                    <DataGridTextColumn Header="Artist"  Binding="{Binding Artist}"              Width="140"
                                    HeaderTemplate="{StaticResource FilterableHeader}" />
                    <DataGridTextColumn Header="No."     Binding="{Binding CollectorNumber}"     Width="55"
                                    HeaderTemplate="{StaticResource FilterableHeader}" />

                </DataGrid.Columns>
            </DataGrid>

            <!-- Empty-state -->
            <Border Grid.Row="1" Background="#20000000" CornerRadius="8"
                Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text="{Binding EmptyMessage}" TextAlignment="Center" TextWrapping="Wrap"
                       MaxWidth="420" Opacity="0.8"
                       VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Border>

            <!-- Loading overlay -->
            <Border Grid.Row="1" Background="#40000000"
                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <ui:ProgressRing IsIndeterminate="True" Width="48" Height="48"/>
                    <TextBlock Text="Loading pool..." Margin="0,12,0,0" HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </Border>

            <!-- ═══ STATUS BAR ═══ -->
            <TextBlock Grid.Row="2" Text="{Binding StatusText}"
                   FontSize="13" Opacity="0.7" Margin="0,6,0,0"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
        </Grid>
        <!-- end right content grid -->
    </Grid>
</Page>
