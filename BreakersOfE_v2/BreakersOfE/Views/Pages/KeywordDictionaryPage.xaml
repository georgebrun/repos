<Page x:Class="BreakersOfE.Views.Pages.KeywordDictionaryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      ScrollViewer.VerticalScrollBarVisibility="Disabled"
      Loaded="Page_Loaded"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <!-- Keyword Dictionary: a reference. Look up any keyword (Horsemanship,
         Scry, Landfall …): what it means, the official rules, an example
         card, and the cards that have it — then show them in the Pool or in
         your collection. -->
    <Page.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,16,0,6"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
        </Style>
        <!-- Read-only, selectable text (copy a rule). Its own style replaces the
             theme's TextBox look, so the text color is set here. -->
        <Style x:Key="Reading" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
    </Page.Resources>

    <DockPanel Margin="16">
        <!-- Official rules: when they were downloaded, and a button to get them now -->
        <Border DockPanel.Dock="Top" Background="#15808080" CornerRadius="8" Padding="12,8" Margin="0,0,0,10">
            <DockPanel>
                <Button x:Name="BtnGetRules" DockPanel.Dock="Right" Content="Get the Official Rules" Padding="12,4"
                        Click="BtnGetRules_Click"
                        ToolTip="Download Wizards' Comprehensive Rules now (Update Database also does this)"/>
                <TextBlock x:Name="RulesStatus" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="12" Margin="0,0,12,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ═══ LEFT: find a keyword ═══ -->
            <DockPanel Grid.Column="0">
                <TextBox x:Name="SearchBox" DockPanel.Dock="Top" Margin="0,0,0,6" FontSize="14"
                         TextChanged="SearchBox_TextChanged"
                         ToolTip="Type part of a keyword: hors… finds Horsemanship"/>
                <ComboBox x:Name="CategoryBox" DockPanel.Dock="Top" Margin="0,0,0,6"
                          SelectionChanged="CategoryBox_SelectionChanged"/>
                <TextBlock x:Name="ListCount" DockPanel.Dock="Bottom" Margin="2,6,0,0" FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                <ListBox x:Name="KeywordList" SelectionChanged="KeywordList_SelectionChanged"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold" Margin="4,10,0,4"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding CardsText}" FontSize="12" Margin="8,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                <TextBlock Text="{Binding Name}" Opacity="{Binding TextOpacity}" TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <!-- ═══ RIGHT: the keyword ═══ -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="Detail" Margin="0,0,12,16">
                    <TextBlock x:Name="KwName" FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock x:Name="KwMeta" Margin="0,4,0,0" FontSize="13" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <WrapPanel x:Name="ShowButtons" Margin="0,12,0,0">
                        <Button x:Name="BtnShowPool" Content="Show in Pool" Padding="12,4" Margin="0,0,8,0"
                                Click="BtnShowPool_Click" ToolTip="Card Pool → Cards, filtered to this keyword"/>
                        <Button x:Name="BtnShowCollection" Content="Show in My Collection" Padding="12,4"
                                Click="BtnShowCollection_Click" ToolTip="Collection → Cards, filtered to this keyword"/>
                    </WrapPanel>

                    <StackPanel x:Name="DefinitionPart">
                        <TextBlock x:Name="DefinitionHeader" Text="WHAT IT MEANS" Style="{StaticResource SectionHeader}"/>
                        <TextBox x:Name="DefinitionText" Style="{StaticResource Reading}"/>
                    </StackPanel>

                    <StackPanel x:Name="RulesPart">
                        <TextBlock x:Name="RulesHeader" Text="OFFICIAL RULES" Style="{StaticResource SectionHeader}"/>
                        <TextBox x:Name="RulesText" Style="{StaticResource Reading}" FontSize="13"/>
                    </StackPanel>

                    <StackPanel x:Name="ExamplePart">
                        <TextBlock Text="EXAMPLE CARD" Style="{StaticResource SectionHeader}"/>
                        <TextBlock x:Name="ExampleName" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock x:Name="ExampleType" FontSize="12" Margin="0,2,0,6" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <TextBox x:Name="ExampleText" Style="{StaticResource Reading}" FontSize="13"/>
                    </StackPanel>

                    <StackPanel x:Name="CardsPart">
                        <TextBlock x:Name="CardsHeader" Text="CARDS WITH IT" Style="{StaticResource SectionHeader}"/>
                        <TextBox x:Name="CardsText" Style="{StaticResource Reading}" FontSize="13"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Page>
