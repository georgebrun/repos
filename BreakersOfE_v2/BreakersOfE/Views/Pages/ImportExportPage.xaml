<Page x:Class="BreakersOfE.Views.Pages.ImportExportPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      ScrollViewer.VerticalScrollBarVisibility="Disabled"
      Loaded="Page_Loaded"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <!-- Edit → Import / Export. Import: read a file or pasted text, match
         every line to the card pool, PREVIEW (pick printings / finishes where
         needed), then Import as one Undo step. Export: files for other apps
         and BoE's own full collection file. -->
    <Grid Margin="16">
        <TabControl x:Name="Tabs" SelectionChanged="Tabs_SelectionChanged">
            <!-- ═══════════════════ IMPORT ═══════════════════ -->
            <TabItem Header="Import">
                <DockPanel Margin="0,10,0,0">
                    <!-- Options -->
                    <Border DockPanel.Dock="Top" Background="{DynamicResource BoePanelBrush}" CornerRadius="8" Padding="12,8" Margin="0,0,0,8">
                        <StackPanel>
                            <WrapPanel VerticalAlignment="Center">
                                <TextBlock Text="Import into" VerticalAlignment="Center" Margin="0,0,6,0"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                <ComboBox x:Name="TargetBox" Width="230" Margin="0,0,16,0" VerticalAlignment="Center"
                                          SelectionChanged="TargetBox_SelectionChanged"/>
                                <TextBlock Text="Format" VerticalAlignment="Center" Margin="0,0,6,0"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                <ComboBox x:Name="FormatBox" Width="320" Margin="0,0,16,0" VerticalAlignment="Center"
                                          ToolTip="Auto-detect works for most files; pick one if a file is read wrongly"
                                          SelectionChanged="FormatBox_SelectionChanged"/>
                                <RadioButton x:Name="AddRadio" Content="Add to what I have" IsChecked="True" GroupName="Mode"
                                             VerticalAlignment="Center" Margin="0,0,12,0" Checked="Mode_Checked"
                                             ToolTip="The file's copies go on top of what's already there"/>
                                <RadioButton x:Name="ReplaceRadio" Content="Replace (match the file)" GroupName="Mode"
                                             VerticalAlignment="Center" Margin="0,0,16,0" Checked="Mode_Checked"
                                             ToolTip="Make it match the file exactly: anything not in the file is removed (copies claimed by decks or the Trade Binder stay). Asks first; Undo takes it back."/>
                                <StackPanel x:Name="DeckNamePanel" Orientation="Horizontal" Visibility="Collapsed">
                                    <TextBlock Text="Deck name" VerticalAlignment="Center" Margin="0,0,6,0"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    <TextBox x:Name="DeckNameBox" Width="240" VerticalAlignment="Center"/>
                                </StackPanel>
                            </WrapPanel>
                            <WrapPanel Margin="0,8,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="DefaultsLabel" Text="Lines that don't say go in as" VerticalAlignment="Center" Margin="0,0,6,0"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                <ComboBox x:Name="LanguageBox" Width="170" Margin="0,0,6,0" VerticalAlignment="Center"
                                          SelectionChanged="Defaults_SelectionChanged"
                                          ToolTip="Language for lines without one"/>
                                <ComboBox x:Name="ConditionBox" Width="180" Margin="0,0,24,0" VerticalAlignment="Center"
                                          SelectionChanged="Defaults_SelectionChanged"
                                          ToolTip="Condition for lines without one"/>
                                <Button x:Name="BtnOpen" Content="Open File…" Padding="10,4" Margin="0,0,6,0" Click="BtnOpen_Click"
                                        ToolTip="A .csv or .txt card list from BoE or another app"/>
                                <Button x:Name="BtnPaste" Content="Paste Text" Padding="10,4" Margin="0,0,12,0" Click="BtnPaste_Click"
                                        ToolTip="Paste a list, e.g. a deck an AI or a website gave you"/>
                                <TextBlock x:Name="SourceText" VerticalAlignment="Center" FontSize="12" TextTrimming="CharacterEllipsis" MaxWidth="520"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </WrapPanel>
                            <!-- Pasted text -->
                            <DockPanel x:Name="PastePanel" Margin="0,8,0,0" Visibility="Collapsed">
                                <StackPanel DockPanel.Dock="Right" Margin="8,0,0,0">
                                    <Button x:Name="BtnReadPasted" Content="Read Pasted Text" Padding="10,4" Margin="0,0,0,6" Click="BtnReadPasted_Click"/>
                                    <Button Content="Clear" Padding="10,4" Click="BtnClearPasted_Click"/>
                                </StackPanel>
                                <TextBox x:Name="PasteBox" Height="140" AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap"
                                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                         FontFamily="Consolas" FontSize="12"
                                         ToolTip="One card per line: 4 Lightning Bolt (M10) 146 *F*  — headers like Commander / Deck / Sideboard are understood"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <!-- Bottom: import / undo / status -->
                    <Border DockPanel.Dock="Bottom" Background="{DynamicResource BoePanelBrush}" CornerRadius="8" Padding="12,8" Margin="0,8,0,0">
                        <StackPanel>
                            <WrapPanel VerticalAlignment="Center">
                                <Button x:Name="BtnApply" Content="Import" Padding="10,4" Margin="0,0,8,0" IsEnabled="False" Click="BtnApply_Click"/>
                                <Button x:Name="BtnUndo" Content="Undo Last Import" Padding="10,4" Margin="0,0,16,0" IsEnabled="False" Click="BtnUndo_Click"/>
                                <CheckBox x:Name="OnlyAttention" Content="Show only lines that need attention" VerticalAlignment="Center"
                                          Checked="OnlyAttention_Changed" Unchecked="OnlyAttention_Changed"/>
                            </WrapPanel>
                            <TextBlock x:Name="ActionText" Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </Border>

                    <!-- Summary of the preview -->
                    <TextBlock x:Name="SummaryText" DockPanel.Dock="Top" Margin="2,0,0,6" FontSize="12" TextWrapping="Wrap"
                               Text="Open a file or paste a list to see what would be imported. Nothing changes until you press Import."/>

                    <!-- Preview -->
                    <DataGrid x:Name="PreviewGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal" SelectionMode="Single"
                              EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Standard">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Line" Binding="{Binding LineNumber}" IsReadOnly="True" Width="55"/>
                            <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" IsReadOnly="True" Width="50"/>
                            <DataGridTextColumn Header="As written" Binding="{Binding Source}" IsReadOnly="True" Width="260"/>
                            <DataGridTemplateColumn Header="Printing" Width="300">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding Candidates}" SelectedItem="{Binding Chosen, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  IsEnabled="{Binding CanChoose}" DisplayMemberPath="Text" Margin="0" Padding="6,2"
                                                  ToolTip="{Binding Chosen.Name}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Card" Binding="{Binding CardName}" IsReadOnly="True" Width="200"/>
                            <DataGridTemplateColumn Header="Finish" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding FinishChoices}" SelectedItem="{Binding FinishDisplay, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  Margin="0" Padding="6,2"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Language" Binding="{Binding LanguageText}" IsReadOnly="True" Width="110"/>
                            <DataGridTextColumn Header="Condition" Binding="{Binding ConditionText}" IsReadOnly="True" Width="125"/>
                            <DataGridTemplateColumn Header="Status" Width="*" MinWidth="220">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" TextWrapping="Wrap"
                                                   VerticalAlignment="Center" ToolTip="{Binding StatusText}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- ═══════════════════ EXPORT ═══════════════════ -->
            <TabItem Header="Export">
                <DockPanel Margin="0,10,0,0">
                    <!-- What and how -->
                    <Border DockPanel.Dock="Top" Background="{DynamicResource BoePanelBrush}" CornerRadius="8" Padding="12,8" Margin="0,0,0,8">
                        <StackPanel>
                            <WrapPanel VerticalAlignment="Center">
                                <TextBlock Text="Export" VerticalAlignment="Center" Margin="0,0,6,0"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                <ComboBox x:Name="ExportSourceBox" Width="190" Margin="0,0,8,0" VerticalAlignment="Center"
                                          SelectionChanged="ExportOption_Changed"/>
                                <ComboBox x:Name="ExportDeckBox" Width="280" Margin="0,0,16,0" VerticalAlignment="Center"
                                          Visibility="Collapsed" DisplayMemberPath="Text" SelectionChanged="ExportOption_Changed"
                                          ToolTip="The deck to export"/>
                                <TextBlock Text="as" VerticalAlignment="Center" Margin="0,0,6,0"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                <ComboBox x:Name="ExportFormatBox" Width="420" VerticalAlignment="Center"
                                          DisplayMemberPath="Text" SelectionChanged="ExportOption_Changed"/>
                            </WrapPanel>
                            <WrapPanel Margin="0,8,0,0" VerticalAlignment="Center">
                                <CheckBox x:Name="ExportOnlyFree" Content="Only copies I can use" Margin="0,0,20,0" VerticalAlignment="Center"
                                          Checked="ExportOption_Changed" Unchecked="ExportOption_Changed"
                                          ToolTip="Leave out copies claimed by decks or the Trade Binder — so a deck builder (MTG Deck Tools) only uses cards that are free"/>
                                <CheckBox x:Name="ExportTokens" Content="Include tokens" Margin="0,0,20,0" VerticalAlignment="Center"
                                          Checked="ExportOption_Changed" Unchecked="ExportOption_Changed"
                                          ToolTip="Collection: your tokens too. Deck: the deck's Tokens part."/>
                                <CheckBox x:Name="ExportMarkFinish" Content="Mark foil and etched (*F* / *E*)" Margin="0,0,20,0" VerticalAlignment="Center"
                                          Checked="ExportOption_Changed" Unchecked="ExportOption_Changed"
                                          ToolTip="Adds *F* or *E* after foil and etched lines (Moxfield, Archidekt and BoE read it). Leave off for sites that don't."/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- Bottom: copy / save -->
                    <Border DockPanel.Dock="Bottom" Background="{DynamicResource BoePanelBrush}" CornerRadius="8" Padding="12,8" Margin="0,8,0,0">
                        <StackPanel>
                            <WrapPanel VerticalAlignment="Center">
                                <Button x:Name="BtnExportCopy" Content="Copy to Clipboard" Padding="10,4" Margin="0,0,8,0" IsEnabled="False"
                                        Click="BtnExportCopy_Click" ToolTip="Then paste it into the website (e.g. MTG Deck Tools)"/>
                                <Button x:Name="BtnExportSave" Content="Save File…" Padding="10,4" Margin="0,0,16,0" IsEnabled="False"
                                        Click="BtnExportSave_Click"/>
                                <TextBlock x:Name="ExportSummary" VerticalAlignment="Center" FontSize="12" TextWrapping="Wrap" MaxWidth="900"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </WrapPanel>
                            <TextBlock x:Name="ExportText" Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </Border>

                    <!-- Preview of the export -->
                    <TextBlock DockPanel.Dock="Top" Text="Preview — exactly what will be copied or saved" Margin="2,0,0,4" FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <TextBox x:Name="ExportPreview" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             FontFamily="Consolas" FontSize="12" VerticalContentAlignment="Top"/>
                </DockPanel>
            </TabItem>
        </TabControl>
    </Grid>
</Page>
