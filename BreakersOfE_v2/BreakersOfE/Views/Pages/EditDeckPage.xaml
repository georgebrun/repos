<Page x:Class="BreakersOfE.Views.Pages.EditDeckPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ctl="clr-namespace:BreakersOfE.Views.Controls"
      ScrollViewer.VerticalScrollBarVisibility="Disabled"
      Loaded="Page_Loaded"
      PreviewKeyDown="Page_PreviewKeyDown"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <!-- Edit → Decks: Pool → Deck and Collection → Deck (the source on top,
         the deck below) and Deck → Collection (the deck on top, the collection
         below). Same tables as View, embedded; the card detail panel on the
         left for whichever card was selected last. Every change is saved at once. -->
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="DetailColumn" Width="240" MinWidth="180" MaxWidth="480"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*" MinWidth="300"/>
        </Grid.ColumnDefinitions>

        <!-- ═══ LEFT DETAIL PANEL (last card selected in either table) ═══ -->
        <ctl:CardDetailPanel x:Name="Detail" Grid.Column="0" Margin="0,0,4,0"/>

        <!-- Drag to widen or narrow the card panel -->
        <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                      DragCompleted="DetailSplitter_DragCompleted"
                      Background="Transparent" Cursor="SizeWE" Margin="0,0,4,0"
                      ToolTip="Drag to resize the card panel">
            <GridSplitter.Template>
                <ControlTemplate TargetType="GridSplitter">
                    <Border Background="Transparent">
                        <Border Width="4" Height="48" CornerRadius="2" Background="#60A0A0A0"
                                HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </GridSplitter.Template>
        </GridSplitter>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="TopRow" Height="*" MinHeight="140"/>
                <!-- source (Deck → Collection: the deck) -->
                <RowDefinition Height="Auto"/>
                <!-- splitter -->
                <RowDefinition x:Name="BottomRow" Height="*" MinHeight="200"/>
                <!-- buttons + deck (Deck → Collection: the collection) -->
            </Grid.RowDefinitions>

            <!-- ═══ TOP: the source (card pool or collection); Deck → Collection: the deck ═══ -->
            <Frame Grid.Row="0" x:Name="TopFrame" NavigationUIVisibility="Hidden"
                   JournalOwnership="OwnsJournal" Focusable="False"/>

            <!-- Drag to share the height between the two tables (remembered) -->
            <GridSplitter Grid.Row="1" x:Name="TableSplitter" Height="12" HorizontalAlignment="Stretch"
                          ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                          Background="Transparent" Cursor="SizeNS" Margin="0,2,0,2"
                          DragCompleted="TableSplitter_DragCompleted"
                          ToolTip="Drag to resize the tables">
                <GridSplitter.Template>
                    <ControlTemplate TargetType="GridSplitter">
                        <Border Background="Transparent">
                            <Border Height="4" Width="80" CornerRadius="2" Background="#60A0A0A0"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </GridSplitter.Template>
            </GridSplitter>

            <DockPanel Grid.Row="2">
                <!-- ═══ DECK + BUTTONS ═══ -->
                <Border DockPanel.Dock="Top" Background="#15808080" CornerRadius="8"
                    Padding="12,6" Margin="0,0,0,8">
                    <StackPanel>
                        <!-- Which deck -->
                        <WrapPanel VerticalAlignment="Center" Margin="0,0,0,6">
                            <TextBlock Text="Deck" VerticalAlignment="Center" Margin="0,0,6,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <ComboBox x:Name="DeckBox" Width="340" Margin="0,0,8,0" VerticalAlignment="Center"
                                  IsTextSearchEnabled="True"
                                  SelectionChanged="DeckBox_SelectionChanged"
                                  ToolTip="The deck you're building (type to jump to a deck). Every change is saved at once."/>
                            <Button x:Name="BtnNewDeck" Content="New Deck…" Padding="10,4" Margin="0,0,6,0"
                                Click="BtnNewDeck_Click" ToolTip="Start a new deck: name, type and format"/>
                            <Button x:Name="BtnDeckSettings" Content="Deck Settings…" Padding="10,4" Margin="0,0,6,0"
                                Click="BtnDeckSettings_Click" ToolTip="Rename the deck, or change its type or format"/>
                            <Button x:Name="BtnCloseDeck" Content="Close Deck" Padding="10,4" Margin="0,0,6,0"
                                Click="BtnCloseDeck_Click"
                                ToolTip="Close the deck (it's already saved). With no deck open, nothing can be added or removed."/>
                            <Button x:Name="BtnTearDown" Content="Tear Down…" Padding="10,4" Margin="0,0,18,0"
                                Click="BtnTearDown_Click"
                                ToolTip="Every copy the deck claims goes back to Available in your collection, and the deck is deleted (after asking)"/>

                            <TextBlock x:Name="AddToLabel" Text="Add to" VerticalAlignment="Center" Margin="0,0,6,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <ComboBox x:Name="AddToBox" Width="140" Margin="0,0,18,0" VerticalAlignment="Center"
                                  SelectionChanged="AddToBox_SelectionChanged"
                                  ToolTip="Where cards added from the pool go (tokens always go to the deck's Tokens part)"/>

                            <TextBlock x:Name="PoolLabel" Text="Pool" VerticalAlignment="Center" Margin="0,0,6,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <ComboBox x:Name="PoolBox" Width="110" Margin="0,0,6,0" VerticalAlignment="Center"
                                  SelectionChanged="PoolBox_SelectionChanged"
                                  ToolTip="Cards or tokens (tokens go to the deck's Tokens part)"/>
                            <Button x:Name="BtnSuggestTokens" Content="Suggested Tokens…" Padding="10,4" Margin="0,0,18,0"
                                Click="BtnSuggestTokens_Click"
                                ToolTip="The tokens this deck's cards make (as Scryfall links them) — tick the ones to add; the ones you own are claimed"/>

                            <Button x:Name="BtnUndo" Content="Undo" Padding="10,4"
                                Click="BtnUndo_Click" ToolTip="Nothing to undo (Ctrl+Z)"/>
                        </WrapPanel>

                        <!-- Pool → Deck, Collection → Deck: add and remove -->
                        <WrapPanel x:Name="EditBar" VerticalAlignment="Center">
                            <TextBlock Text="Add/Remove Qty" VerticalAlignment="Center" Margin="0,0,6,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <TextBox x:Name="QtyBox" Text="1" Width="56" Margin="0,0,14,0"
                                 VerticalAlignment="Center" TextAlignment="Center"
                                 PreviewTextInput="QtyBox_PreviewTextInput"
                                 PreviewKeyDown="QtyBox_PreviewKeyDown"
                                 GotKeyboardFocus="QtyBox_GotKeyboardFocus"
                                 ToolTip="How many to add or remove (Ctrl+Q). Enter adds the default finish. To set an exact count, double-click a Non-Foil / Foil / Etched cell in the deck table."/>

                            <Button x:Name="BtnAddNonFoil" Content="Add Non-Foil" Padding="10,4" Margin="0,0,6,0"
                                Click="BtnAddNonFoil_Click" ToolTip="Add Qty non-foil copies (Enter)"/>
                            <Button x:Name="BtnAddFoil" Content="Add Foil" Padding="10,4" Margin="0,0,6,0"
                                Click="BtnAddFoil_Click" ToolTip="Add Qty foil copies (Shift+Enter)"/>
                            <Button x:Name="BtnAddEtched" Content="Add Etched" Padding="10,4" Margin="0,0,18,0"
                                Click="BtnAddEtched_Click" ToolTip="Add Qty etched copies (Ctrl+Enter)"/>

                            <Button x:Name="BtnRemoveNonFoil" Content="Remove Non-Foil" Padding="10,4" Margin="0,0,6,0"
                                Click="BtnRemoveNonFoil_Click" ToolTip="Remove Qty non-foil copies from the deck"/>
                            <Button x:Name="BtnRemoveFoil" Content="Remove Foil" Padding="10,4" Margin="0,0,6,0"
                                Click="BtnRemoveFoil_Click" ToolTip="Remove Qty foil copies from the deck"/>
                            <Button x:Name="BtnRemoveEtched" Content="Remove Etched" Padding="10,4" Margin="0,0,6,0"
                                Click="BtnRemoveEtched_Click" ToolTip="Remove Qty etched copies from the deck"/>
                            <Button x:Name="BtnRemoveLine" Content="Remove Card" Padding="10,4"
                                Click="BtnRemoveLine_Click" ToolTip="Take the selected card(s) out of the deck — every copy (Shift+Delete)"/>
                        </WrapPanel>

                        <!-- Deck → Collection: claim copies you own, or add new ones -->
                        <WrapPanel x:Name="ClaimBar" VerticalAlignment="Center" Visibility="Collapsed">
                            <Button x:Name="BtnUseOwned" Content="Use Copies I Own" Padding="10,4" Margin="0,0,6,0"
                                Click="BtnUseOwned_Click"
                                ToolTip="The selected deck cards: claim free copies you own — same printing and finish, English first, worst condition first (Enter)"/>
                            <Button x:Name="BtnAddNew" Content="Add as New Copies" Padding="10,4" Margin="0,0,6,0"
                                Click="BtnAddNew_Click"
                                ToolTip="The selected deck cards: add what they still need to your collection as new copies (Language · Condition below), claimed for the deck"/>
                            <Button x:Name="BtnUseRow" Content="Use This Row" Padding="10,4" Margin="0,0,6,0"
                                Click="BtnUseRow_Click"
                                ToolTip="The selected collection row: claim its free copies for what the deck still needs of that card"/>
                            <Button x:Name="BtnFreeCopies" Content="Free Copies" Padding="10,4" Margin="0,0,18,0"
                                Click="BtnFreeCopies_Click"
                                ToolTip="The selected deck cards: their claimed copies go back to Available (the cards stay in the deck) (Delete)"/>

                            <TextBlock Text="New copies as" VerticalAlignment="Center" Margin="0,0,6,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <ComboBox x:Name="LanguageBox" Width="150" Margin="0,0,6,0" VerticalAlignment="Center"
                                  ToolTip="Language of new copies added to your collection"/>
                            <ComboBox x:Name="ConditionBox" Width="170" Margin="0,0,18,0" VerticalAlignment="Center"
                                  ToolTip="Condition of new copies added to your collection"/>

                            <Button x:Name="BtnWholeOwned" Content="Whole Deck: Use Copies I Own…" Padding="10,4" Margin="0,0,6,0"
                                Click="BtnWholeOwned_Click"
                                ToolTip="Preview, then claim free copies you own for everything the deck still needs"/>
                            <Button x:Name="BtnWholeNew" Content="Whole Deck: Add as New…" Padding="10,4" Margin="0,0,6,0"
                                Click="BtnWholeNew_Click"
                                ToolTip="Preview, then add everything the deck still needs to your collection as new copies (a sealed precon)"/>
                            <Button x:Name="BtnFindMissing" Content="Find Missing…" Padding="10,4"
                                Click="BtnFindMissing_Click"
                                ToolTip="What the deck still needs: other printings you own of those cards (you choose — never automatic), and the rest to the Want List, with prices"/>
                        </WrapPanel>
                        <!-- The card the buttons act on, and how many the deck has of it -->
                        <TextBlock x:Name="ModeText" Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <!-- What the last action did (amber when something was refused or warned) -->
                        <TextBlock x:Name="ActionText" Margin="0,2,0,0" FontSize="12" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </Border>

                <!-- ═══ BOTTOM: the deck; Deck → Collection: the collection ═══ -->
                <Frame x:Name="BottomFrame" NavigationUIVisibility="Hidden"
                   JournalOwnership="OwnsJournal" Focusable="False"/>
            </DockPanel>
        </Grid>
    </Grid>
</Page>
