<ui:FluentWindow x:Class="BreakersOfE.Views.SetCompletionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Set Completion"
        Width="900" Height="700"
        MinWidth="600" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ExtendsContentIntoTitleBar="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title bar: drag to move, minimize / maximize / close (X) -->
        <ui:TitleBar Grid.Row="0" Title="Set Completion"/>

        <Grid Grid.Row="1" Margin="16,4,16,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header: overall numbers + "only sets I own" -->
            <DockPanel Grid.Row="0" Margin="0,0,0,10" LastChildFill="False">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="Set Completion" FontSize="20" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <TextBlock x:Name="SummaryText" FontSize="13" Margin="0,4,0,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
                <CheckBox x:Name="ChkOwnedOnly" DockPanel.Dock="Right" VerticalAlignment="Center"
                      Content="Only sets I own cards from" IsChecked="True"
                      Checked="ChkOwnedOnly_Changed" Unchecked="ChkOwnedOnly_Changed"/>
            </DockPanel>

            <!-- Sortable table: click a header to sort; double-click a row to open the set -->
            <DataGrid Grid.Row="1" x:Name="SetsGrid"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  HeadersVisibility="Column"
                  GridLinesVisibility="None"
                  RowHeaderWidth="0"
                  RowHeight="28"
                  CanUserSortColumns="True"
                  EnableRowVirtualization="True"
                  VirtualizingPanel.IsVirtualizing="True"
                  MouseDoubleClick="SetsGrid_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="" Width="36" CanUserSort="False" CanUserResize="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Image Source="{Binding Symbol}" Width="20" Height="20"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Set"      Binding="{Binding Name}"             Width="*"   SortMemberPath="Name"/>
                    <DataGridTextColumn Header="Code"     Binding="{Binding Code}"             Width="70"  SortMemberPath="Code"/>
                    <DataGridTextColumn Header="Released" Binding="{Binding ReleasedAt}"       Width="100" SortMemberPath="ReleasedAt"/>
                    <DataGridTextColumn Header="Owned"    Binding="{Binding OwnedText}"        Width="110" SortMemberPath="OwnedCount"/>
                    <DataGridTemplateColumn Header="Complete" Width="170" SortMemberPath="CompletionPercent">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid VerticalAlignment="Center" Margin="0,0,8,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="46"/>
                                    </Grid.ColumnDefinitions>
                                    <ProgressBar Grid.Column="0" Height="6" Maximum="100"
                                             Value="{Binding CompletionPercent, Mode=OneWay}"
                                             VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding CompletionText}"
                                           TextAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Set value" Binding="{Binding TotalValueText}"  Width="100" SortMemberPath="TotalValue"/>
                    <DataGridTextColumn Header="Missing"   Binding="{Binding MissingValueText}" Width="100" SortMemberPath="MissingValue"/>
                </DataGrid.Columns>
            </DataGrid>

            <DockPanel Grid.Row="2" Margin="0,10,0,0" LastChildFill="True">
                <Button DockPanel.Dock="Right" Content="Close" Padding="16,5"
                    Click="BtnClose_Click"/>
                <TextBlock FontSize="12" Opacity="0.7" VerticalAlignment="Center" TextWrapping="Wrap"
                       Margin="0,0,12,0"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="Counts each printing (collector number); any copy, foil or not, makes it owned. Double-click a set to open it."/>
            </DockPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
