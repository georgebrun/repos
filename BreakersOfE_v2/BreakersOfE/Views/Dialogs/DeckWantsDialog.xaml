<ui:FluentWindow x:Class="BreakersOfE.Views.Dialogs.DeckWantsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Want List"
        Width="720" Height="560" MinWidth="520" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        ExtendsContentIntoTitleBar="True"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <!-- Tear Down (and the Want List page, for decks already gone): the deck's
         wants. Ticked: kept on the Want List for the Collection. Unticked: removed. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="Want List"/>

        <DockPanel Grid.Row="1" Margin="16,0,16,14">
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                <TextBlock x:Name="HeaderText" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock x:Name="NoteText" Style="{StaticResource BoeHint}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="Select All" Padding="10,4" Margin="0,0,6,0" Click="All_Click" ToolTip="Keep every card on the Want List"/>
                    <Button Content="Select None" Padding="10,4" Click="None_Click" ToolTip="Remove every card from the Want List"/>
                    <TextBlock x:Name="CountText" VerticalAlignment="Center" Margin="12,0,0,0" FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </StackPanel>

            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <ui:Button x:Name="BtnOk" Appearance="Primary" MinWidth="96" Margin="0,0,8,0" IsDefault="True" Click="Ok_Click"/>
                <ui:Button x:Name="BtnCancel" Content="Cancel" MinWidth="72" IsCancel="True"/>
            </StackPanel>

            <DataGrid x:Name="WantGrid" AutoGenerateColumns="False" HeadersVisibility="Column"
                      GridLinesVisibility="None" RowHeaderWidth="0" SelectionMode="Single"
                      CanUserAddRows="False" CanUserDeleteRows="False">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Keep" Width="55" SortMemberPath="Keep">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding Keep, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          HorizontalAlignment="Center" MinWidth="0" Click="Keep_Click"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="45" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Printing" Binding="{Binding Printing}" Width="100" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Finish" Binding="{Binding FinishText}" Width="80" IsReadOnly="True"/>
                    <DataGridTextColumn x:Name="ForColumn" Header="Was for" Binding="{Binding ForDeckName}" Width="150" IsReadOnly="True"/>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </Grid>
</ui:FluentWindow>
