<ui:FluentWindow x:Class="BreakersOfE.Views.Dialogs.TokenSuggestionsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Suggested Tokens"
        Width="640" SizeToContent="Height" MaxHeight="720"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <!-- Edit → Decks: the tokens the deck's cards make (Scryfall's links).
         Tick the ones to add to the deck's Tokens part. -->
    <DockPanel Margin="18,16,18,14">
        <TextBlock DockPanel.Dock="Top" x:Name="HeaderText" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
        <TextBlock DockPanel.Dock="Top" x:Name="NoteText" Margin="0,4,0,0" FontSize="12" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
        <TextBlock DockPanel.Dock="Bottom" x:Name="PrintStatus" Margin="0,8,0,0" FontSize="12" TextWrapping="Wrap"
                   Visibility="Collapsed" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

        <!-- Bottom row: copies, then the actions -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0" LastChildFill="False">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" x:Name="QtyPanel">
                <TextBlock Text="Copies of each" VerticalAlignment="Center" Margin="0,0,8,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                <TextBox x:Name="QtyBox" Text="1" Width="56" TextAlignment="Center" VerticalAlignment="Center"
                         PreviewTextInput="QtyBox_PreviewTextInput"/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <ui:Button x:Name="BtnPrint" Content="Print Ticked…" MinWidth="96" Margin="0,0,8,0"
                           Click="Print_Click"
                           ToolTip="Print paper slips of the ticked tokens (Copies of each), 9 to a US Letter page, to cut out and sleeve over a card"/>
                <ui:Button x:Name="BtnAdd" Content="Add Ticked" Appearance="Primary" MinWidth="96" Margin="0,0,8,0"
                           IsDefault="True" Click="Add_Click"/>
                <ui:Button x:Name="BtnCancel" Content="Cancel" MinWidth="72" IsCancel="True"/>
            </StackPanel>
        </DockPanel>

        <!-- Row above it: which tokens to tick -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" x:Name="TickPanel" Margin="0,14,0,0">
            <TextBlock Text="Tick" VerticalAlignment="Center" Margin="0,0,8,0"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            <Button Content="All" Padding="10,4" Margin="0,0,6,0" Click="All_Click" ToolTip="Tick every token"/>
            <Button Content="None" Padding="10,4" Margin="0,0,6,0" Click="None_Click" ToolTip="Untick every token"/>
            <Button Content="Owned" Padding="10,4" Margin="0,0,6,0" Click="Owned_Click"
                    ToolTip="Tick only the tokens in your token collection that the deck doesn't have yet"/>
            <Button Content="Not Owned" Padding="10,4" Click="NotOwned_Click"
                    ToolTip="Tick only the tokens you don't have in your token collection (the ones to print)"/>
        </StackPanel>

        <ScrollViewer Margin="0,12,0,0" VerticalScrollBarVisibility="Auto" MaxHeight="480">
            <ItemsControl x:Name="TokenList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" Margin="0,0,0,8"
                                  VerticalContentAlignment="Top">
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" FontSize="12"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </CheckBox>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</ui:FluentWindow>
