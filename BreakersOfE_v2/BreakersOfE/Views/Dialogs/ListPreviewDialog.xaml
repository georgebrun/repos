<ui:FluentWindow x:Class="BreakersOfE.Views.Dialogs.ListPreviewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Preview"
        Width="640" SizeToContent="Height" MaxHeight="720"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <!-- Edit → Decks → Deck → Collection: what a whole-deck action will do, before it's done. -->
    <DockPanel Margin="18,16,18,14">
        <TextBlock DockPanel.Dock="Top" x:Name="HeaderText" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
        <TextBlock DockPanel.Dock="Top" x:Name="NoteText" Margin="0,4,0,0" FontSize="12" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <ui:Button x:Name="BtnOk" Appearance="Primary" MinWidth="96" Margin="0,0,8,0"
                       IsDefault="True" Click="Ok_Click"/>
            <ui:Button Content="Cancel" MinWidth="72" IsCancel="True"/>
        </StackPanel>

        <ScrollViewer Margin="0,12,0,0" VerticalScrollBarVisibility="Auto" MaxHeight="480">
            <ItemsControl x:Name="LineList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</ui:FluentWindow>
