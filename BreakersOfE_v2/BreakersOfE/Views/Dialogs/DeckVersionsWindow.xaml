<ui:FluentWindow x:Class="BreakersOfE.Views.Dialogs.DeckVersionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Deck Versions"
        Width="900" Height="640" MinWidth="640" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        ExtendsContentIntoTitleBar="True"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <!-- Edit → Decks → Versions…: saved copies of the deck with a note.
         Compare one with the deck now (or two with each other), restore one,
         delete one. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" x:Name="WindowTitleBar" Title="Deck Versions"/>

        <DockPanel Grid.Row="1" Margin="16,0,16,14">
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                <TextBlock x:Name="HeaderText" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock Style="{StaticResource BoeHint}" TextWrapping="Wrap" Margin="0,2,0,0"
                           Text="Saved copies of this deck. One is saved when the deck builder makes a deck and before a restore; Save Version saves one now. Select one to compare it with the deck now, or two to compare them with each other."/>
            </StackPanel>

            <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <ui:Button Content="Save Version…" Margin="0,0,8,0" Click="Save_Click"
                               ToolTip="Save the deck as it is now, with a note"/>
                    <ui:Button x:Name="BtnCompare" Content="Compare" Margin="0,0,8,0" Click="Compare_Click" IsEnabled="False"
                               ToolTip="One selected: what changed from it to the deck now. Two selected: from the older to the newer."/>
                    <ui:Button x:Name="BtnRestore" Content="Restore…" Margin="0,0,8,0" Click="Restore_Click" IsEnabled="False"
                               ToolTip="Make this version the deck again (the deck now is saved as a version first)"/>
                    <ui:Button x:Name="BtnDelete" Content="Delete" Margin="0,0,8,0" Click="Delete_Click" IsEnabled="False"/>
                    <ui:Button Content="Close" MinWidth="72" IsCancel="True" Click="Close_Click"/>
                </StackPanel>
                <TextBlock x:Name="StatusText" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            </DockPanel>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="400"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <DataGrid x:Name="VersionGrid" Grid.Column="0" AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" GridLinesVisibility="None" RowHeaderWidth="0"
                          SelectionMode="Extended" SelectionChanged="VersionGrid_SelectionChanged" Margin="0,0,12,0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Saved" Binding="{Binding SavedText}" Width="140" SortMemberPath="Saved"/>
                        <DataGridTextColumn Header="Cards" Binding="{Binding Cards}" Width="55"/>
                        <DataGridTextColumn Header="Note" Binding="{Binding Note}" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="ToolTip" Value="{Binding Note}"/>
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBox x:Name="CompareText" Grid.Column="1" IsReadOnly="True" FontFamily="Consolas" FontSize="13"
                         TextWrapping="NoWrap" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
            </Grid>
        </DockPanel>
    </Grid>
</ui:FluentWindow>
