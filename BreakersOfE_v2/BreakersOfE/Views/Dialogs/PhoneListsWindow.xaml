<ui:FluentWindow x:Class="BreakersOfE.Views.Dialogs.PhoneListsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Phone Lists"
        Width="720" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ExtendsContentIntoTitleBar="True"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <!-- Trade Binder / Want List: the Phone… button, and once (while off) when
         either page opens. The same settings as Settings → Phone lists. -->
    <StackPanel>
        <ui:TitleBar Title="Phone Lists"/>
        <StackPanel Margin="18,0,18,16">
            <TextBlock Text="Take your Trade Binder and Want List with you" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock Style="{StaticResource BoeHint}" TextWrapping="Wrap" Margin="0,4,0,10"
                       Text="On your phone, iPhone or Android, for the store or a trade: pictures, search, filters by color or deck, prices and your asking prices. BoE keeps a file, BoE Lists.json, in your cloud drive up to date as your collection changes, and the BoE Lists page on your phone opens it, even without signal. Only these two lists go in the file. Free, with no account to make."/>

            <CheckBox x:Name="OnCheck" Content="Keep my Trade Binder and Want List on my phone" Margin="0,0,0,10" Click="On_Click"/>

            <StackPanel x:Name="OnPanel">
                <TextBlock Text="CLOUD DRIVE FILE" FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                <TextBlock x:Name="FileText" TextWrapping="Wrap" Margin="0,2,0,6"/>
                <WrapPanel Margin="0,0,0,6">
                    <Button Content="Change Folder…" Padding="10,4" Margin="0,0,8,0" Click="ChangeFolder_Click"
                            ToolTip="A folder in OneDrive, Google Drive, iCloud Drive or Dropbox on this PC (its desktop app must be running)"/>
                    <Button Content="Open Folder" Padding="10,4" Margin="0,0,8,0" Click="OpenFolder_Click"/>
                    <Button Content="Update Now" Padding="10,4" Click="Update_Click"
                            ToolTip="Write the lists now (BoE also does it by itself whenever your collection changes)"/>
                </WrapPanel>
                <TextBlock x:Name="StatusText" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

                <DockPanel>
                    <Border DockPanel.Dock="Left" Background="White" CornerRadius="8" Padding="8" Margin="0,0,16,0" VerticalAlignment="Top">
                        <Image x:Name="QrImage" Width="140" Height="140" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                    </Border>
                    <StackPanel>
                        <TextBlock Text="On your phone" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,2" Text="1.  Point the camera at the code to open the BoE Lists page."/>
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,2" Text="2.  Add it to your Home Screen (iPhone: Share → Add to Home Screen; Android: ⋮ → Add to Home screen)."/>
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,8" Text="3.  Open it, tap Open my lists file, and pick BoE Lists.json in your cloud drive. Tap Update there to get newer lists."/>
                        <WrapPanel>
                            <TextBlock x:Name="UrlText" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <Button Content="Copy Address" Padding="10,4" Click="Copy_Click"/>
                        </WrapPanel>
                    </StackPanel>
                </DockPanel>
            </StackPanel>

            <Separator Margin="0,14,0,10"/>
            <DockPanel>
                <ui:Button DockPanel.Dock="Right" Content="Close" MinWidth="80" IsCancel="True"/>
                <StackPanel VerticalAlignment="Center">
                    <CheckBox x:Name="DontShowCheck" Content="Don't show this again" Margin="0,0,0,2"/>
                    <TextBlock Style="{StaticResource BoeHint}" TextWrapping="Wrap"
                               Text="You can change this any time in Settings → Phone lists, or with the Phone… button here."/>
                </StackPanel>
            </DockPanel>
        </StackPanel>
    </StackPanel>
</ui:FluentWindow>
