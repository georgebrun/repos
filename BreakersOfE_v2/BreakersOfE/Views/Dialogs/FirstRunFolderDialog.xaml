<ui:FluentWindow x:Class="BreakersOfE.Views.Dialogs.FirstRunFolderDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Breakers of E — Welcome"
        Width="600" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <!-- First start after installing: where BoE keeps its data (asked once). -->
    <StackPanel Margin="22,20,22,18">
        <TextBlock Text="Welcome to Breakers of E" FontSize="20" FontWeight="SemiBold"/>
        <TextBlock Margin="0,10,0,0" TextWrapping="Wrap"
                   Text="Where should BoE keep your data? Your collection, decks, card data, exports and kept card pictures all go in this one folder."/>
        <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" FontSize="12"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Text="The card data takes a few hundred MB; downloading every card picture takes several GB more. You can move the folder later in Settings → Data folder."/>

        <DockPanel Margin="0,16,0,0">
            <ui:Button DockPanel.Dock="Right" Content="Browse…" Margin="8,0,0,0" Click="Browse_Click"/>
            <TextBox x:Name="FolderBox" IsReadOnly="True" VerticalContentAlignment="Center"/>
        </DockPanel>
        <TextBlock x:Name="NoteText" Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
        <TextBlock x:Name="ErrorText" Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap"
                   Foreground="{DynamicResource BoeWarningBrush}" Visibility="Collapsed"/>

        <DockPanel Margin="0,18,0,0" LastChildFill="False">
            <ui:Button x:Name="BtnDefault" DockPanel.Dock="Left" Content="Use the Default (Documents\BoE_V2)" Click="Default_Click"/>
            <ui:Button DockPanel.Dock="Right" Content="Start BoE" Appearance="Primary" MinWidth="100"
                       IsDefault="True" Click="Start_Click"/>
        </DockPanel>
    </StackPanel>
</ui:FluentWindow>
