<ui:FluentWindow x:Class="BreakersOfE.Views.Dialogs.TextPromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="BoE"
        Width="440" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <!-- One line of text (a name): title, what it's for, the box, OK / Cancel. -->
    <StackPanel Margin="18,16,18,14">
        <TextBlock x:Name="TitleText" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
        <TextBlock x:Name="PromptText" Margin="0,4,0,0" FontSize="12" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
        <TextBox x:Name="InputBox" Margin="0,12,0,0"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <ui:Button Content="OK" Appearance="Primary" MinWidth="72" Margin="0,0,8,0"
                       IsDefault="True" Click="Ok_Click"/>
            <ui:Button Content="Cancel" MinWidth="72" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</ui:FluentWindow>
