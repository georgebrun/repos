<ui:FluentWindow x:Class="BreakersOfE.Views.Dialogs.OtherSideWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Other Side"
        Width="900" Height="680" MinWidth="640" MinHeight="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        ExtendsContentIntoTitleBar="True"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <!-- Collection → Tokens, right-click → Other Side…: what this token row is
         paired with (Unpair), and pair it with another of your token rows. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" x:Name="WindowTitleBar" Title="Other Side"/>

        <DockPanel Grid.Row="1" Margin="16,0,16,14">
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                <TextBlock x:Name="HeaderText" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock x:Name="SubText" Style="{StaticResource BoeHint}" TextWrapping="Wrap" Margin="0,2,0,0"/>
            </StackPanel>

            <!-- Paired with -->
            <StackPanel DockPanel.Dock="Top" Margin="0,8,0,0">
                <TextBlock Text="PAIRED WITH" FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                <DockPanel Margin="0,4,0,0">
                    <ui:Button x:Name="BtnUnpair" DockPanel.Dock="Right" Content="Unpair" MinWidth="80" Margin="8,0,0,0"
                               VerticalAlignment="Top" IsEnabled="False" Click="Unpair_Click"
                               ToolTip="Each side becomes its own card again"/>
                    <DataGrid x:Name="PairedGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                              GridLinesVisibility="None" RowHeaderWidth="0" SelectionMode="Single" MaxHeight="130" MinHeight="54"
                              HorizontalScrollBarVisibility="Disabled"
                              SelectionChanged="PairedGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Other side" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Edition" Binding="{Binding SetCode}" Width="80"/>
                            <DataGridTextColumn Header="No." Binding="{Binding CollectorNumber}" Width="60"/>
                            <DataGridTextColumn Header="Row" Binding="{Binding Key.Text}" Width="220"/>
                            <DataGridTextColumn Header="Cards" Binding="{Binding Count}" Width="60"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
                <TextBlock x:Name="NoPairText" Text="Not paired: a single-sided token." Margin="0,4,0,0" FontStyle="Italic"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            </StackPanel>

            <!-- Pair with: the card pool's tokens of this release -->
            <StackPanel DockPanel.Dock="Top" Margin="0,14,0,4">
                <TextBlock Text="PAIR WITH THE TOKEN ON ITS BACK" FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                <DockPanel Margin="0,4,0,0">
                    <TextBlock DockPanel.Dock="Left" Text="Find" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox x:Name="FindBox" TextChanged="Filter_Changed"
                             ToolTip="Part of a name, an edition code or a collector number"/>
                </DockPanel>
                <WrapPanel Margin="0,6,0,0">
                    <CheckBox x:Name="SameSetsCheck" IsChecked="True" Margin="0,0,18,0" Click="Release_Changed"
                              ToolTip="Only the tokens of this release: all its token sets (booster, Commander …), as View → Sets groups them"/>
                    <CheckBox x:Name="MineCheck" Content="Only my tokens not on a pair" Click="Filter_Changed"
                              ToolTip="Only tokens you have in Collection → Tokens with copies not paired yet"/>
                </WrapPanel>
            </StackPanel>

            <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <TextBlock Text="Cards" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox x:Name="CountBox" Text="1" Width="50" TextAlignment="Center" Margin="0,0,10,0" VerticalAlignment="Center"
                             ToolTip="How many physical cards have these two sides"/>
                    <ui:Button x:Name="BtnPair" Content="Pair" Appearance="Primary" MinWidth="80" Margin="0,0,8,0"
                               IsEnabled="False" Click="Pair_Click"/>
                    <ui:Button Content="Close" MinWidth="72" IsCancel="True"/>
                </StackPanel>
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            </DockPanel>

            <DataGrid x:Name="ChoiceGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                      GridLinesVisibility="None" RowHeaderWidth="0" SelectionMode="Single"
                      HorizontalScrollBarVisibility="Disabled"
                      SelectionChanged="ChoiceGrid_SelectionChanged" MouseDoubleClick="ChoiceGrid_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="Edition" Binding="{Binding SetCode}" Width="75"/>
                    <DataGridTextColumn Header="No." Binding="{Binding Number}" Width="55" SortMemberPath="NumberSort"/>
                    <DataGridTextColumn Header="P/T" Binding="{Binding PT}" Width="50"/>
                    <DataGridTextColumn Header="Owned" Binding="{Binding OwnedText}" Width="65" SortMemberPath="Owned"/>
                    <DataGridTextColumn Header="Not paired" Binding="{Binding OffPairText}" Width="85" SortMemberPath="OffPair"/>
                    <DataGridTextColumn Header="In use" Binding="{Binding InUseText}" Width="60" SortMemberPath="InUse"/>
                    <DataGridTextColumn Header="Paired with" Binding="{Binding PairedWith}" Width="150"/>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </Grid>
</ui:FluentWindow>
