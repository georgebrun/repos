<ui:FluentWindow x:Class="BreakersOfE.Views.Dialogs.GotItDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Got It"
        Width="520" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <!-- Want List → Got It: how many copies arrived, and which wants they fill
         (decks first, then the Collection). Ticked wants get copies in order;
         copies left over stay free in the collection. -->
    <StackPanel Margin="18,16,18,14">
        <TextBlock Text="Got It" FontSize="16" FontWeight="SemiBold"/>
        <TextBlock x:Name="CardText" Margin="0,4,0,0" FontSize="12" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
            <TextBlock Text="Copies received" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox x:Name="CountBox" Width="70" TextAlignment="Center" VerticalAlignment="Center"
                     PreviewTextInput="CountBox_PreviewTextInput" TextChanged="CountBox_TextChanged"/>
            <TextBlock x:Name="WantedText" VerticalAlignment="Center" Margin="8,0,0,0"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
        </StackPanel>

        <TextBlock Text="They're for" Margin="0,14,0,4" FontWeight="SemiBold"/>
        <ItemsControl x:Name="WantList">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0" IsChecked="{Binding IsChecked, Mode=TwoWay}" Click="Want_Click"
                                  ToolTip="{Binding Tip}">
                            <TextBlock Text="{Binding Label}" TextWrapping="Wrap"/>
                        </CheckBox>
                        <TextBlock Grid.Column="1" Text="{Binding GetsText}" VerticalAlignment="Center" Margin="12,0,0,0"
                                   FontWeight="SemiBold"/>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock x:Name="SummaryText" Margin="0,10,0,0" FontSize="12" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <ui:Button Content="Got It" Appearance="Primary" MinWidth="72" Margin="0,0,8,0"
                       IsDefault="True" Click="Ok_Click"/>
            <ui:Button Content="Cancel" MinWidth="72" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</ui:FluentWindow>
