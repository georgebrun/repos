<ui:FluentWindow x:Class="BreakersOfE.Views.Dialogs.DeckSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Deck"
        Width="520" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <!-- Edit → Decks: a new deck, or an open deck's name, type and format. -->
    <StackPanel Margin="18,16,18,14">
        <TextBlock x:Name="HeaderText" Text="New Deck" FontSize="15" FontWeight="SemiBold"/>

        <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Name" VerticalAlignment="Center" Margin="0,0,10,8"/>
            <TextBox Grid.Row="0" Grid.Column="1" x:Name="NameBox" Margin="0,0,0,8"/>

            <TextBlock Grid.Row="1" Text="Deck type" VerticalAlignment="Center" Margin="0,0,10,8"/>
            <ComboBox Grid.Row="1" Grid.Column="1" x:Name="TypeBox" Margin="0,0,0,8"
                      SelectionChanged="TypeBox_SelectionChanged"/>

            <TextBlock Grid.Row="2" x:Name="FormatLabel" Text="Format" VerticalAlignment="Center" Margin="0,0,10,8"/>
            <ComboBox Grid.Row="2" Grid.Column="1" x:Name="FormatBox" Margin="0,0,0,8"
                      ToolTip="Which Constructed format the deck is built for (which cards are legal)"/>

            <TextBlock Grid.Row="3" Text="Description" VerticalAlignment="Top" Margin="0,6,10,0"/>
            <TextBox Grid.Row="3" Grid.Column="1" x:Name="DescriptionBox" Height="60"
                     TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
        </Grid>

        <!-- The rules of the chosen deck type (DeckFormats) -->
        <TextBlock x:Name="RulesText" Margin="0,12,0,0" FontSize="12" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
        <TextBlock x:Name="ErrorText" Margin="0,8,0,0" FontSize="12" TextWrapping="Wrap"
                   Foreground="#E8A317" Visibility="Collapsed"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <ui:Button x:Name="BtnOk" Content="Create" Appearance="Primary" MinWidth="72" Margin="0,0,8,0"
                       IsDefault="True" Click="Ok_Click"/>
            <ui:Button Content="Cancel" MinWidth="72" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</ui:FluentWindow>
