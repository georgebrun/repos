<ui:FluentWindow x:Class="BreakersOfE.Views.Dialogs.Rule0Window"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Rule 0 Sheet"
        Width="760" Height="620" MinWidth="480" MinHeight="320"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        ExtendsContentIntoTitleBar="True"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <!-- The Rule 0 sheet: what to tell the table before a game. Copy or save it. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="Rule 0 Sheet"/>

        <DockPanel Grid.Row="1" Margin="16,0,16,14">
            <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <ui:Button Content="Copy" MinWidth="72" Margin="0,0,8,0" Click="Copy_Click"/>
                    <ui:Button Content="Save…" MinWidth="72" Margin="0,0,8,0" Click="Save_Click"/>
                    <ui:Button Content="Close" MinWidth="72" IsCancel="True" Click="Close_Click"/>
                </StackPanel>
                <TextBlock x:Name="StatusText" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            </DockPanel>
            <TextBox x:Name="SheetText" IsReadOnly="True" FontFamily="Consolas" FontSize="13"
                     TextWrapping="NoWrap" AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
        </DockPanel>
    </Grid>
</ui:FluentWindow>
