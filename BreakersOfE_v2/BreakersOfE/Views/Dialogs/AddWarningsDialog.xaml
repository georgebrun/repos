<ui:FluentWindow x:Class="BreakersOfE.Views.Dialogs.AddWarningsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Add anyway?"
        Width="560" SizeToContent="Height" MaxHeight="640"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <!-- Edit → Decks: a card being added breaks a deck rule. A warning, never a block. -->
    <DockPanel Margin="18,16,18,14">
        <TextBlock DockPanel.Dock="Top" x:Name="HeaderText" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <ui:Button x:Name="BtnAddAll" Content="Add anyway" Appearance="Primary" MinWidth="96" Margin="0,0,8,0"
                       Click="AddAll_Click"/>
            <ui:Button x:Name="BtnSkip" Content="Add only the others" MinWidth="96" Margin="0,0,8,0"
                       Click="Skip_Click"/>
            <ui:Button Content="Cancel" MinWidth="72" IsCancel="True" IsDefault="True"/>
        </StackPanel>

        <TextBlock DockPanel.Dock="Bottom" x:Name="HintText" Margin="0,10,0,0" FontSize="12" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

        <ScrollViewer Margin="0,10,0,0" VerticalScrollBarVisibility="Auto" MaxHeight="420">
            <ItemsControl x:Name="WarningList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Margin="0,0,0,6">
                            <TextBlock DockPanel.Dock="Left" Text="⚠" Foreground="{DynamicResource BoeWarningBrush}" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                        </DockPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</ui:FluentWindow>
