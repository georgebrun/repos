<ui:FluentWindow x:Class="BreakersOfE.Views.Playtest.PlaytestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:ctl="clr-namespace:BreakersOfE.Views.Controls"
        Title="Playtest"
        Width="1440" Height="900"
        MinWidth="1000" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        ExtendsContentIntoTitleBar="True"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <ui:FluentWindow.Resources>
        <!-- A pile (library, graveyard, exile, command zone): picture, name, count -->
        <Style x:Key="PileName" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="#D0E0E0E0"/>
        </Style>
        <Style x:Key="PileBox" TargetType="Border">
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Background" Value="#22000000"/>
            <Setter Property="BorderBrush" Value="#30FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </ui:FluentWindow.Resources>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition x:Name="LogRowDef" Height="40" MinHeight="36"/>
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="WindowTitleBar" Title="Playtest" Grid.Row="0"/>

        <!-- ═══ Toolbar ═══ -->
        <DockPanel Grid.Row="1" Margin="10,0,10,6" LastChildFill="False">
            <!-- The steps of the turn: click one to go to it (P: the next step) -->
            <DockPanel DockPanel.Dock="Bottom" Margin="0,6,0,0" LastChildFill="False">
                <StackPanel x:Name="PhaseBar" DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center"/>
                <Button x:Name="BtnNextStep" DockPanel.Dock="Left" Content="Next Step ▸" Padding="10,3" Margin="8,0,0,0"
                        Click="BtnNextStep_Click" ToolTip="On to the next step of the turn (P)"/>
            </DockPanel>
            <WrapPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                <Button x:Name="BtnNewGame" Content="New Game ▾" Padding="10,4" Margin="0,0,6,0" Click="BtnNewGame_Click"
                        ToolTip="Start over: on your own, or against another of your decks"/>
                <Button x:Name="BtnUndo" Content="Undo" Padding="10,4" Margin="0,0,18,0" Click="BtnUndo_Click"
                        ToolTip="Take back the last move (Ctrl+Z)"/>
                <Button x:Name="BtnDraw" Content="Draw" Padding="10,4" Margin="0,0,6,0" Click="BtnDraw_Click"
                        ToolTip="Draw a card (D). Right-click the library for more."/>
                <Button x:Name="BtnShuffle" Content="Shuffle" Padding="10,4" Margin="0,0,6,0" Click="BtnShuffle_Click"
                        ToolTip="Shuffle the library (S)"/>
                <Button x:Name="BtnUntapAll" Content="Untap All" Padding="10,4" Margin="0,0,6,0" Click="BtnUntapAll_Click"
                        ToolTip="Untap everything (U)"/>
                <Button x:Name="BtnTokens" Content="Tokens ▾" Padding="10,4" Margin="0,0,6,0" Click="BtnTokens_Click"
                        ToolTip="Make a token: this deck's Tokens part, or any token from the card pool"/>
                <Button x:Name="BtnSampleHands" Content="Sample Hands" Padding="10,4" Margin="0,0,6,0" Click="BtnSampleHands_Click"
                        ToolTip="Deal practice opening hands from this deck, one after another (this game isn't touched)"/>
                <Button x:Name="BtnPassTurn" Content="Next Turn" Padding="10,4" Margin="12,0,10,0" Click="BtnPassTurn_Click"
                        ToolTip="Next turn: untap everything and draw (N)"/>
                <TextBlock x:Name="TurnText" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold"/>
            </WrapPanel>
            <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Center">
                <TextBlock x:Name="DeckText" VerticalAlignment="Center" Margin="0,0,12,0" FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                <Button x:Name="BtnFullScreen" Content="⛶ Full Screen" Padding="10,4" Margin="0,0,6,0" Click="BtnFullScreen_Click"
                        ToolTip="Full screen (F11; Esc to leave)"/>
                <Button x:Name="BtnSettings" Content="⚙ Table" Padding="10,4" Margin="0,0,6,0" Click="BtnSettings_Click"
                        ToolTip="The table's own settings: sleeves, card size, mulligan, life"/>
                <Button Content="?" Padding="10,4" Click="BtnHelp_Click" ToolTip="Help: the playtest table (F1)"/>
            </WrapPanel>
        </DockPanel>

        <!-- ═══ The table: your mat (a real 24×14 playmat), your badge on its left, your piles on its right, your hand held below ═══ -->
        <Border x:Name="TableBorder" Grid.Row="2" Margin="10,0,10,0" CornerRadius="10" Background="#FF26302B" ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Your badge: portrait (your commander), life, mana, counters on you -->
                    <StackPanel x:Name="MyBadge" Grid.Column="0" Width="150" Margin="10,10,4,10" VerticalAlignment="Bottom">
                        <Border x:Name="MyPortraitBox" Width="110" Height="110" HorizontalAlignment="Center" CornerRadius="10"
                                BorderBrush="#70FFFFFF" BorderThickness="2" Background="#40000000" ClipToBounds="True" Margin="0,0,0,6"
                                ToolTip="You (⚙ Table → Badge: your picture)"/>
                        <TextBlock x:Name="MyName" Style="{StaticResource PileName}" Margin="0,0,0,4"/>
                        <Border Style="{StaticResource PileBox}" Margin="0,0,0,8" Padding="6,4">
                            <StackPanel>
                                <TextBlock Text="LIFE" Style="{StaticResource PileName}"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Content="−" Width="30" Padding="0,2" Click="LifeDown_Click" ToolTip="Lose 1 life (Shift: 5)"/>
                                    <TextBlock x:Name="LifeText" MinWidth="58" TextAlignment="Center" FontSize="32"
                                               FontWeight="SemiBold" Foreground="White" Margin="4,0" Cursor="Hand"
                                               MouseLeftButtonDown="LifeText_MouseDown" ToolTip="Double-click to type a life total"/>
                                    <Button Content="+" Width="30" Padding="0,2" Click="LifeUp_Click" ToolTip="Gain 1 life (Shift: 5)"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <!-- Mana pool: click +1, right-click −1; MANA empties it or keeps it this turn -->
                        <Border Style="{StaticResource PileBox}" Margin="0,0,0,8" Padding="6,4">
                            <StackPanel>
                                <TextBlock x:Name="ManaTitle" Text="MANA" Style="{StaticResource PileName}" Cursor="Hand"
                                           MouseLeftButtonUp="ManaTitle_Click"/>
                                <UniformGrid x:Name="ManaPool" Columns="3" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <!-- Counters on you: click +1, right-click −1 -->
                        <Border Style="{StaticResource PileBox}" Margin="0" Padding="8,4">
                            <WrapPanel x:Name="PlayerCounters" HorizontalAlignment="Center"/>
                        </Border>
                    </StackPanel>

                    <!-- The table between: the opponent's side across it (two players), then your mat -->
                    <Grid x:Name="OuterField" Grid.Column="1" ClipToBounds="True">
                        <Grid.RowDefinitions>
                            <RowDefinition x:Name="OppRow" Height="0"/>
                            <RowDefinition x:Name="SplitRow" Height="0"/>
                            <RowDefinition x:Name="MyRow" Height="*"/>
                        </Grid.RowDefinitions>
                        <!-- Player 2 across the table: their hand held at the far edge (backs), their badge, their mat (farther, so smaller), their piles -->
                        <Border x:Name="OppArea" Grid.Row="0" Visibility="Collapsed" ClipToBounds="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Canvas x:Name="OppHand" Grid.Row="0" Grid.Column="1" Height="34" ClipToBounds="True"/>
                                <StackPanel x:Name="OppBadge" Grid.Column="0" Grid.RowSpan="2" Width="120" Margin="4,8,4,6" VerticalAlignment="Top">
                                    <Border x:Name="OppPortraitBox" Width="72" Height="72" HorizontalAlignment="Center" CornerRadius="8"
                                            BorderBrush="#70FFFFFF" BorderThickness="2" Background="#40000000" ClipToBounds="True" Margin="0,0,0,4"
                                            ToolTip="Player 2 (⚙ Table → Player: their name and picture)"/>
                                    <TextBlock x:Name="OppName" Style="{StaticResource PileName}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,4"/>
                                    <Border Style="{StaticResource PileBox}" Margin="0,0,0,4" Padding="6,2">
                                        <StackPanel>
                                            <TextBlock Text="LIFE" Style="{StaticResource PileName}"/>
                                            <TextBlock x:Name="OppLife" HorizontalAlignment="Center" FontSize="24" FontWeight="SemiBold" Foreground="White"/>
                                        </StackPanel>
                                    </Border>
                                    <TextBlock x:Name="OppInfo" Style="{StaticResource PileName}" TextWrapping="Wrap" TextAlignment="Center"/>
                                </StackPanel>
                                <Grid x:Name="OppFieldArea" Grid.Row="1" Grid.Column="1" SizeChanged="OppFieldArea_SizeChanged">
                                    <Border x:Name="OppMatBox" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="10"
                                            Background="#30000000" BorderBrush="#50000000" BorderThickness="2" ClipToBounds="True">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.5"/>
                                        </Border.Effect>
                                        <Grid>
                                            <!-- Their playmat faces them: upside down from your side of the table -->
                                            <Image x:Name="OppPlaymatImage" Stretch="Fill" IsHitTestVisible="False" RenderOptions.BitmapScalingMode="HighQuality"
                                                   RenderTransformOrigin="0.5,0.5">
                                                <Image.RenderTransform>
                                                    <RotateTransform Angle="180"/>
                                                </Image.RenderTransform>
                                            </Image>
                                            <Border x:Name="OppPlaymatShade" Background="Black" Opacity="0" IsHitTestVisible="False"/>
                                            <Canvas x:Name="OppField" Background="Transparent" ClipToBounds="True" Margin="5"
                                                    SizeChanged="Area_SizeChanged"/>
                                        </Grid>
                                    </Border>
                                </Grid>
                                <StackPanel x:Name="OppPiles" Grid.Column="2" Grid.RowSpan="2" Margin="4,8,4,6" VerticalAlignment="Top"/>
                            </Grid>
                        </Border>
                        <GridSplitter x:Name="OppSplitter" Grid.Row="1" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                      ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" Background="#30FFFFFF"
                                      Visibility="Collapsed" ToolTip="Drag: more room for one side or the other"/>
                        <Grid x:Name="FieldArea" Grid.Row="2" SizeChanged="FieldArea_SizeChanged">
                            <!-- Your mat: playmat proportions, centered, the table around it -->
                            <Border x:Name="MatBox" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="12"
                                    Background="#30000000" BorderBrush="#50000000" BorderThickness="2" ClipToBounds="True">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.55"/>
                                </Border.Effect>
                                <Grid>
                                    <Image x:Name="PlaymatImage" Stretch="Fill" IsHitTestVisible="False" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    <Border x:Name="PlaymatShade" Background="Black" Opacity="0" IsHitTestVisible="False"/>
                                    <Canvas x:Name="Field" Background="Transparent" ClipToBounds="True" Margin="8"
                                            SizeChanged="Area_SizeChanged" MouseLeftButtonDown="Field_MouseDown"/>
                                </Grid>
                            </Border>

                            <!-- A combo came together -->
                            <Border x:Name="ComboBanner" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,8,0,0"
                                    Padding="12,6" CornerRadius="8" Background="#F0302410" BorderBrush="Gold" BorderThickness="1"
                                    Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="ComboText" Foreground="White" VerticalAlignment="Center" MaxWidth="560"
                                               TextWrapping="Wrap" FontWeight="SemiBold"/>
                                    <Button Content="How It Goes…" Padding="8,2" Margin="10,0,4,0" Click="ComboSteps_Click"/>
                                    <Button Content="✕" Padding="8,2" Click="ComboClose_Click" ToolTip="Close"/>
                                </StackPanel>
                            </Border>

                            <!-- The stack: the latest on top resolves first -->
                            <Border x:Name="StackPanelBox" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,8,10,0"
                                    Padding="8" CornerRadius="8" Background="#E0181A1E" BorderBrush="#60FFFFFF" BorderThickness="1"
                                    Visibility="Collapsed">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,6">
                                        <Button DockPanel.Dock="Right" Content="Resolve All" Padding="8,2" Click="ResolveAll_Click"/>
                                        <Button DockPanel.Dock="Right" Content="Resolve (R)" Padding="8,2" Margin="0,0,6,0" Click="ResolveTop_Click"/>
                                        <TextBlock Text="THE STACK" Foreground="#C0FFFFFF" FontSize="11" FontWeight="SemiBold"
                                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    </DockPanel>
                                    <StackPanel x:Name="StackCards"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- Your piles: library, graveyard, exile, command zone -->
                    <StackPanel x:Name="PileRow" Grid.Column="2" Margin="4,10,10,10" VerticalAlignment="Bottom">
                        <Border x:Name="CommandPile" Style="{StaticResource PileBox}" Margin="0,0,0,8"
                                ToolTip="Command zone: drag your commander to the battlefield to cast it (the tax is counted). Drop it here to send it back.">
                            <StackPanel>
                                <StackPanel x:Name="CommandSlot" Orientation="Horizontal" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="CommandText" Style="{StaticResource PileName}"/>
                            </StackPanel>
                        </Border>
                        <Border x:Name="ExilePile" Style="{StaticResource PileBox}" Margin="0,0,0,8" Cursor="Hand"
                                MouseLeftButtonUp="ExilePile_Click"
                                ToolTip="Exile: click to look through it. Drop a card here to exile it (E).">
                            <StackPanel>
                                <Grid x:Name="ExileSlot"/>
                                <TextBlock x:Name="ExileText" Style="{StaticResource PileName}"/>
                            </StackPanel>
                        </Border>
                        <Border x:Name="GraveyardPile" Style="{StaticResource PileBox}" Margin="0,0,0,8" Cursor="Hand"
                                MouseLeftButtonUp="GraveyardPile_Click"
                                ToolTip="Graveyard: click to look through it. Drop a card here to put it in the graveyard (G).">
                            <StackPanel>
                                <Grid x:Name="GraveyardSlot"/>
                                <TextBlock x:Name="GraveyardText" Style="{StaticResource PileName}"/>
                            </StackPanel>
                        </Border>
                        <Border x:Name="LibraryPile" Style="{StaticResource PileBox}" Margin="0" Cursor="Hand"
                                MouseLeftButtonUp="LibraryPile_Click" MouseRightButtonUp="LibraryPile_RightClick"
                                ToolTip="Library: click to draw; right-click for more. Drop a card here to put it on top (Shift: bottom).">
                            <StackPanel>
                                <Grid x:Name="LibrarySlot"/>
                                <TextBlock x:Name="LibraryText" Style="{StaticResource PileName}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Your hand, held: fanned along the bottom edge; the card under the mouse lifts and grows -->
                <Grid Grid.Row="1" ClipToBounds="False">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0">
                        <!-- "At the beginning of …" reminders for the steps just entered -->
                        <Border x:Name="ReminderBar" Background="#E0202A38" Padding="12,6" Visibility="Collapsed">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Done" Padding="10,3" Margin="8,0,0,0" VerticalAlignment="Top"
                                        Click="RemindersDone_Click" ToolTip="Put the reminders away (your call what to do with them)"/>
                                <StackPanel x:Name="ReminderList"/>
                            </DockPanel>
                        </Border>
                        <Border x:Name="MulliganBar" Background="#E0302820" Padding="12,8" Visibility="Collapsed">
                            <DockPanel>
                                <StackPanel x:Name="MulliganButtons" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="BtnKeep" Content="Keep (K)" Padding="14,5" Margin="8,0,6,0" Click="BtnKeep_Click"/>
                                    <Button x:Name="BtnMulligan" Content="Mulligan (M)" Padding="14,5" Click="BtnMulligan_Click"/>
                                    <Button x:Name="BtnSkipDiscard" Content="Skip" Padding="14,5" Margin="8,0,0,0" Visibility="Collapsed"
                                            Click="BtnSkipDiscard_Click" ToolTip="Pass the turn without discarding (your call)"/>
                                </StackPanel>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="MulliganTitle" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="MulliganInfo" FontSize="12" Foreground="#E0E0D8C8" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                    <Grid x:Name="HandRow" Grid.Row="1" Background="Transparent" PreviewMouseWheel="HandRow_MouseWheel" ClipToBounds="False">
                        <TextBlock x:Name="HandText" Margin="170,0,0,4" FontSize="11" FontWeight="SemiBold"
                                   Foreground="#90FFFFFF" Cursor="Hand" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                   MouseLeftButtonUp="HandText_Click"
                                   ToolTip="See your whole hand laid out (play or move cards from there)"/>
                        <Canvas x:Name="HandArea" Background="Transparent" ClipToBounds="False" Margin="170,0,120,0"
                                SizeChanged="Area_SizeChanged"/>
                    </Grid>
                </Grid>
            </Grid>
        </Border>

        <!-- ═══ The message bar (the game log): one line, or drag its top edge up to read back ═══ -->
        <GridSplitter x:Name="LogSplitter" Grid.Row="3" Height="5" HorizontalAlignment="Stretch" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                      Background="Transparent" ToolTip="Drag to make the message bar taller or shorter"/>
        <Border x:Name="LogBar" Grid.Row="4" Margin="10,0,10,8" CornerRadius="6" Background="#FF1B1D20" BorderBrush="#30FFFFFF" BorderThickness="1" SizeChanged="LogBar_SizeChanged">
            <DockPanel>
                <StackPanel x:Name="LogButtons" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,3,4,3">
                    <Button Content="▲" Padding="8,0" Height="24" FontSize="12" Margin="0,0,2,0" Click="BtnLogUp_Click" ToolTip="Older messages (or the mouse wheel)"/>
                    <Button Content="▼" Padding="8,0" Height="24" FontSize="12" Margin="0,0,10,0" Click="BtnLogDown_Click" ToolTip="Newer messages (or the mouse wheel)"/>
                    <Button x:Name="BtnLogSize" Content="Expand" Padding="8,0" Height="24" FontSize="12" Margin="0,0,4,0" Click="BtnLogSize_Click"
                            ToolTip="Expand the message bar to read back (Collapse puts it back to one line); you can also drag its top edge"/>
                    <Button Content="Copy" Padding="8,0" Height="24" FontSize="12" Margin="0,0,4,0" Click="BtnLogCopy_Click" ToolTip="Copy the whole log"/>
                    <Button Content="Clear" Padding="8,0" Height="24" FontSize="12" Click="BtnLogClear_Click" ToolTip="Clear the messages shown (the game itself isn't touched)"/>
                </StackPanel>
                <ListBox x:Name="LogList" FontSize="12" Background="Transparent" BorderThickness="0" Padding="0"
                         ScrollViewer.VerticalScrollBarVisibility="Hidden" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <!-- Compact lines, so one line sits in the middle of the closed bar -->
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Setter Property="Padding" Value="10,0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="MinHeight" Value="22"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- A card's attachments fanned out while the mouse is over it -->
        <Canvas x:Name="FanLayer" Grid.RowSpan="5"/>

        <!-- The card under the mouse, grown where it sits (it doesn't catch the mouse) -->
        <Canvas x:Name="HoverLayer" Grid.RowSpan="5" IsHitTestVisible="False"/>

        <!-- The selected card's actions float beside it -->
        <Canvas x:Name="ActionLayer" Grid.RowSpan="5"/>

        <!-- The card being dragged floats here, over everything -->
        <Canvas x:Name="DragLayer" Grid.RowSpan="5" IsHitTestVisible="False"/>

        <!-- Zoom (Z, double-click, L): the card big, both faces of a two-faced card; a click or any key closes it -->
        <Grid x:Name="ZoomLayer" Grid.RowSpan="5" Background="#D0000000" Visibility="Collapsed"
              MouseLeftButtonDown="ZoomLayer_Click" MouseRightButtonDown="ZoomLayer_Click">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel x:Name="ZoomFaces" Orientation="Horizontal" HorizontalAlignment="Center"/>
                <Button x:Name="BtnZoomTurn" Content="Turn Over" Padding="14,5" Margin="0,12,0,0" HorizontalAlignment="Center"
                        Visibility="Collapsed" Click="BtnZoomTurn_Click" ToolTip="See the other face"/>
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
