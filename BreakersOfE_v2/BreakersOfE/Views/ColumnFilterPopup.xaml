<ui:FluentWindow x:Class="BreakersOfE.Views.ColumnFilterPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Filter"
        Width="330" Height="520"
        MinWidth="300" MinHeight="360"
        MaxWidth="440"
        ResizeMode="CanResize"
        WindowStartupLocation="Manual"
        ShowInTaskbar="False"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Sort buttons -->
            <RowDefinition Height="*"/>
            <!-- Tabs -->
            <RowDefinition Height="Auto"/>
            <!-- OK / Cancel / Clear -->
        </Grid.RowDefinitions>

        <!-- ═══ SORT ═══ -->
        <Border Grid.Row="0" BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Padding="6,6,6,3">
            <StackPanel Orientation="Horizontal">
                <ui:Button Content="Sort A → Z" FontSize="11" Padding="6,2" Margin="0,0,4,0"
                        Click="BtnSortAsc_Click"/>
                <ui:Button Content="Sort Z → A" FontSize="11" Padding="6,2"
                        Click="BtnSortDesc_Click"/>
            </StackPanel>
        </Border>

        <!-- ═══ TABS ═══ -->
        <TabControl Grid.Row="1" Name="MainTabControl" Background="Transparent">

            <!-- ── VALUES TAB ── -->
            <TabItem Header="Values">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" BorderThickness="0,0,0,1"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Padding="4">
                        <ui:TextBox Name="ValueSearchBox" Height="28"
                                 FontSize="12"
                                 PlaceholderText="Search values..."
                                 TextChanged="ValueSearchBox_TextChanged"/>
                    </Border>

                    <Border Grid.Row="1" BorderThickness="0,0,0,1"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Padding="8,3">
                        <CheckBox Name="ChkSelectAll" Content="(Select All)"
                                  IsThreeState="True" FontSize="12"
                                  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                  Checked="SelectAll_Changed" Unchecked="SelectAll_Changed"/>
                    </Border>

                    <ListBox Name="ValuesListBox" Grid.Row="2" BorderThickness="0"
                             Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="MinHeight" Value="24"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding DisplayValue}"
                                          IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                          Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                          FontSize="12" Padding="4,1"
                                          Checked="ValueCheckBox_Changed"
                                          Unchecked="ValueCheckBox_Changed"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </TabItem>

            <!-- ── TEXT FILTERS TAB ── -->
            <TabItem Header="Text Filters">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <ComboBox Name="OperatorCombo" Grid.Row="0" Height="28" Margin="0,0,0,6"
                              FontSize="12"
                              SelectionChanged="OperatorCombo_SelectionChanged"/>

                    <ui:TextBox Name="TextFilterBox" Grid.Row="1" Height="28"
                             FontSize="12"
                             PlaceholderText="Filter text..."
                             KeyDown="TextFilterBox_KeyDown"/>

                    <StackPanel Grid.Row="2" Orientation="Vertical" Margin="0,8,0,0">
                        <ui:Button Name="BtnApplyText" Content="Apply"
                                HorizontalAlignment="Left"
                                Width="70" Height="28" Click="BtnApplyText_Click"/>
                        <TextBlock Name="TextHint" Margin="0,6,0,0"
                                   FontSize="11" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="Checks matching values on the Values tab."/>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- ═══ OK / CANCEL / CLEAR ═══ -->
        <Border Grid.Row="2" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Padding="6,5">
            <Grid>
                <ui:Button Name="BtnClearFilter" Content="Clear" FontSize="12"
                        MinWidth="60" Height="28" Padding="10,2"
                        HorizontalAlignment="Left"
                        Click="BtnClearFilter_Click"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <ui:Button Name="BtnOk" Content="OK" Appearance="Primary" FontSize="12"
                            MinWidth="56" Height="28" Padding="10,2" Margin="0,0,6,0"
                            IsDefault="True" Click="BtnOk_Click"/>
                    <ui:Button Name="BtnCancel" Content="Cancel" FontSize="12"
                            MinWidth="62" Height="28" Padding="10,2"
                            IsCancel="True" Click="BtnCancel_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
