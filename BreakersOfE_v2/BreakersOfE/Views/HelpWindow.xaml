<ui:FluentWindow x:Class="BreakersOfE.Views.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Breakers of E — Help"
        Width="1000" Height="720"
        MinWidth="700" MinHeight="450"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        ShowInTaskbar="True"
        ExtendsContentIntoTitleBar="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title bar: drag to move, minimize / maximize / close (X) -->
        <ui:TitleBar Grid.Row="0" Title="Breakers of E — Help"/>

        <Grid Grid.Row="1" Margin="16,4,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" MinWidth="180" MaxWidth="450"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ── Left: search + topics ── -->
            <DockPanel Grid.Column="0">
                <ui:TextBox x:Name="SearchBox" DockPanel.Dock="Top"
                            PlaceholderText="Search Help…"
                            TextChanged="SearchBox_TextChanged"
                            ToolTip="Type words to find the topics that mention all of them"/>
                <TextBlock x:Name="SearchCount" DockPanel.Dock="Top" Style="{StaticResource BoeHint}"
                           Margin="4,6,0,0" Visibility="Collapsed"/>
                <!-- A plain scroll area (the app's: bar beside the list, never over it);
                     no sideways scrolling — long titles wrap instead. -->
                <TreeView x:Name="TopicTree" Margin="0,8,0,0"
                          Background="Transparent" BorderThickness="0"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          SelectedItemChanged="TopicTree_SelectedItemChanged">
                    <TreeView.Template>
                        <ControlTemplate TargetType="TreeView">
                            <ScrollViewer Focusable="False" CanContentScroll="False"
                                          HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Auto">
                                <ItemsPresenter/>
                            </ScrollViewer>
                        </ControlTemplate>
                    </TreeView.Template>
                </TreeView>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="12" HorizontalAlignment="Stretch"
                          Background="Transparent" Cursor="SizeWE"
                          ToolTip="Drag to resize the topic list"/>

            <!-- ── Right: the topic ── -->
            <DockPanel Grid.Column="2">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8" LastChildFill="True">
                    <ui:Button x:Name="BtnBack" DockPanel.Dock="Right" Content="◀  Back"
                               VerticalAlignment="Top" Padding="10,4"
                               Click="BtnBack_Click" IsEnabled="False"
                               ToolTip="Back to the topic you came from"/>
                    <StackPanel>
                        <TextBlock x:Name="TopicTitle" Style="{StaticResource BoePageTitle}" TextWrapping="Wrap"/>
                        <TextBlock x:Name="TopicSubtitle" Style="{StaticResource BoeHint}"/>
                    </StackPanel>
                </DockPanel>
                <ScrollViewer x:Name="ContentScroll" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                    <StackPanel x:Name="ContentPanel" MaxWidth="820" HorizontalAlignment="Left"/>
                </ScrollViewer>
            </DockPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
