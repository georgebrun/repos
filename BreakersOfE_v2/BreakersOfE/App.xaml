<Application x:Class="BreakersOfE.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:converters="clr-namespace:BreakersOfE.Converters"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             StartupUri="Views/MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Wpf.Ui base theme resources — gives us all the Fluent controls -->
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <!-- ═══ Scroll bars: wide and always shown (Wpf.Ui's are 6 px and hide) ═══
                 One look for every scroll bar in the app: tables, gallery, lists,
                 windows. Gray track, lighter thumb that brightens under the mouse. -->
            <!-- The thumb never shrinks below half of this (long tables stay grabbable). -->
            <sys:Double x:Key="{x:Static SystemParameters.VerticalScrollBarButtonHeightKey}">64</sys:Double>
            <sys:Double x:Key="{x:Static SystemParameters.HorizontalScrollBarButtonWidthKey}">64</sys:Double>

            <Style x:Key="BoeScrollPage" TargetType="RepeatButton">
                <Setter Property="OverridesDefaultStyle" Value="True"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="IsTabStop" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RepeatButton">
                            <Border Background="Transparent"/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="BoeScrollThumb" TargetType="Thumb">
                <Setter Property="OverridesDefaultStyle" Value="True"/>
                <Setter Property="IsTabStop" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Thumb">
                            <Border x:Name="Bd" CornerRadius="6" Margin="3" Background="{DynamicResource BoeScrollThumbBrush}"/>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BoeScrollThumbHoverBrush}"/>
                                </Trigger>
                                <Trigger Property="IsDragging" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BoeScrollThumbDragBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <ControlTemplate x:Key="BoeVerticalScrollBar" TargetType="ScrollBar">
                <Border Background="#20808080" CornerRadius="7">
                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                        <Track.DecreaseRepeatButton>
                            <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource BoeScrollPage}"/>
                        </Track.DecreaseRepeatButton>
                        <Track.Thumb>
                            <Thumb Style="{StaticResource BoeScrollThumb}"/>
                        </Track.Thumb>
                        <Track.IncreaseRepeatButton>
                            <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource BoeScrollPage}"/>
                        </Track.IncreaseRepeatButton>
                    </Track>
                </Border>
            </ControlTemplate>

            <ControlTemplate x:Key="BoeHorizontalScrollBar" TargetType="ScrollBar">
                <Border Background="#20808080" CornerRadius="7">
                    <Track x:Name="PART_Track" IsDirectionReversed="False">
                        <Track.DecreaseRepeatButton>
                            <RepeatButton Command="ScrollBar.PageLeftCommand" Style="{StaticResource BoeScrollPage}"/>
                        </Track.DecreaseRepeatButton>
                        <Track.Thumb>
                            <Thumb Style="{StaticResource BoeScrollThumb}"/>
                        </Track.Thumb>
                        <Track.IncreaseRepeatButton>
                            <RepeatButton Command="ScrollBar.PageRightCommand" Style="{StaticResource BoeScrollPage}"/>
                        </Track.IncreaseRepeatButton>
                    </Track>
                </Border>
            </ControlTemplate>

            <Style x:Key="BoeScrollBar" TargetType="ScrollBar">
                <Setter Property="OverridesDefaultStyle" Value="True"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="Opacity" Value="1"/>
                <Setter Property="Width" Value="16"/>
                <Setter Property="MinWidth" Value="16"/>
                <Setter Property="Height" Value="Auto"/>
                <Setter Property="Template" Value="{StaticResource BoeVerticalScrollBar}"/>
                <Style.Triggers>
                    <Trigger Property="Orientation" Value="Horizontal">
                        <Setter Property="Width" Value="Auto"/>
                        <Setter Property="MinWidth" Value="0"/>
                        <Setter Property="Height" Value="16"/>
                        <Setter Property="MinHeight" Value="16"/>
                        <Setter Property="Template" Value="{StaticResource BoeHorizontalScrollBar}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Plain WPF scroll bars and Wpf.Ui's own (DynamicScrollBar) both get it. -->
            <Style TargetType="ScrollBar" BasedOn="{StaticResource BoeScrollBar}"/>
            <Style TargetType="ui:DynamicScrollBar" BasedOn="{StaticResource BoeScrollBar}"/>

            <!-- BoE's theme colours (Settings → Appearance swaps them; these are Dark's). -->
            <SolidColorBrush x:Key="BoeGoldBrush" Color="#FFC000"/>
            <SolidColorBrush x:Key="BoePanelBrush" Color="#15808080"/>
            <SolidColorBrush x:Key="BoeWarningBrush" Color="#E8A317"/>
            <SolidColorBrush x:Key="BoeScrollThumbBrush" Color="#909A9A9A"/>
            <SolidColorBrush x:Key="BoeScrollThumbHoverBrush" Color="#D0C0C0C0"/>
            <SolidColorBrush x:Key="BoeScrollThumbDragBrush" Color="#F0E0E0E0"/>

            <!-- Global value converters — available to all XAML pages -->
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
